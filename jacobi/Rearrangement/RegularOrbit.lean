import jacobi.Rearrangement.RegularFamily
import Mathlib.Topology.ContinuousMap.Bounded.Normed
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals

/-!
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Actual polarizations act continuously on bounded continuous functions. Their
finite orbit, with reflections through zero, has a compact closure for a
regular initial density. A strictly radial weighted integral attains its
maximum on this closure. The next step identifies the maximizing density's shape.
Source: the compact polarization orbit proof of symmetric rearrangement.
Use: the continuous elementary maps generating the compact regular rearrangement orbit.
-/
namespace jacobi.Rearrangement
noncomputable section
open Set Real MeasureTheory Metric Filter
open scoped NNReal Topology BoundedContinuousFunction
set_option backward.isDefEq.respectTransparency false

/-- Two-point polarization as an actual bounded continuous function on the line.
Use: the continuous elementary maps generating the compact regular rearrangement orbit.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
-/
def polarizeBCF (a : ℝ) (f : ℝ →ᵇ ℝ) : ℝ →ᵇ ℝ :=
  BoundedContinuousFunction.mkOfBound ⟨polarize a f, by
    have hr : Continuous (fun x => f (reflect a x)) :=
      f.continuous.comp (reflect_isometry a).continuous
    exact (f.continuous.max hr).if_le (f.continuous.min hr) continuous_id continuous_const
      (fun x hx => by
        subst x
        rw [show reflect a a=a by dsimp [reflect]; ring,max_self,min_self])⟩ (2*‖f‖) (by
    intro x y
    change dist (polarize a f x) (polarize a f y) ≤ 2*‖f‖
    rcases polarize_eq_or a f x with hx | hx <;>
      rcases polarize_eq_or a f y with hy | hy <;>
        rw [hx,hy] <;> exact f.dist_le_two_norm _ _)

/-- The continuous polarization has the literal two-point function as its value.
Use: identifies uniform-space limits and integral identities with actual density polarizations.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: the bounded continuous constructor keeps its defining function. -/
@[simp] theorem polarizeBCF_apply (a : ℝ) (f : ℝ →ᵇ ℝ) (x : ℝ) :
    polarizeBCF a f x=polarize a f x := rfl

/-- Polarization is nonexpansive as a map on the whole uniform function space.
Use: invariance of the closed orbit, rather than only of finite polarization words.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: apply the two-point uniform contraction and the defining uniform distance bound. -/
theorem polarizeBCF_lipschitz (a : ℝ) : LipschitzWith 1 (polarizeBCF a) := by
  apply LipschitzWith.mk_one
  intro f g
  apply (BoundedContinuousFunction.dist_le dist_nonneg).mpr
  intro x
  exact polarize_uniform_distance (fun y => by
    simpa only [Real.dist_eq] using (BoundedContinuousFunction.dist_coe_le_dist (f := f) (g := g) y)) a x

/-- Reflection of a bounded continuous density through the origin.
Use: both orientations of centered rearrangement are available within one compact orbit.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
-/
def mirrorBCF (f : ℝ →ᵇ ℝ) : ℝ →ᵇ ℝ :=
  f.compContinuous ⟨fun x => -x, continuous_neg⟩

/-- The finite orbit generated by centered left polarizations and reflection through zero.
Use: its compact closure contains a symmetric decreasing replacement of the original regular density.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
-/
inductive RegularOrbit (f : ℝ →ᵇ ℝ) : (ℝ →ᵇ ℝ) → Prop
  /-- The unchanged density belongs to its orbit. -/
  | base : RegularOrbit f f
  /-- A preferred half-line containing zero supplies an admissible sorting operation. -/
  | polarize {g : ℝ →ᵇ ℝ} (hg : RegularOrbit f g) (a : ℝ) (ha : 0 ≤ a) :
      RegularOrbit f (polarizeBCF a g)
  /-- Reflection supplies the opposite orientations without changing radial test integrals. -/
  | mirror {g : ℝ →ᵇ ℝ} (hg : RegularOrbit f g) : RegularOrbit f (mirrorBCF g)

/-- Every finite orbit element retains the original common regularity bounds.
Use: compactness of the closed polarization orbit in the uniform norm.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: centered polarization preserves range, support and Lipschitz constant;
reflection through zero preserves the same three bounds. -/
theorem RegularOrbit.regular {f g : ℝ →ᵇ ℝ} {R C : ℝ} {K : ℝ≥0}
    (hg : RegularOrbit f g) (hf : f ∈ regularFamily R C K) : g ∈ regularFamily R C K := by
  -- Induction follows the actual finite construction, with no abstract admissibility certificate.
  induction hg with
  | base => exact hf
  | polarize _ a ha ih => exact polarize_regular ih ha
  | mirror _ ih =>
    refine ⟨?_,fun x => ih.2.1 (-x),fun x hx => ih.2.2 (-x) (by simpa only [abs_neg] using hx)⟩
    simpa only [mirrorBCF,BoundedContinuousFunction.coe_compContinuous,ContinuousMap.coe_mk,mul_one]
      using ih.1.comp (show LipschitzWith 1 (fun x : ℝ => -x) from isometry_neg.lipschitzWith)

/-- The closed orbit of a regular initial density is compact.
Use: a radial test integral attains its maximum on an actual orbit closure.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: the regular family is compact and closed and contains every finite orbit element. -/
theorem regularOrbit_compact {f : ℝ →ᵇ ℝ} {R C : ℝ} {K : ℝ≥0}
    (hR : 0 ≤ R) (hf : f ∈ regularFamily R C K) :
    IsCompact (closure {g | RegularOrbit f g}) :=
  (regularFamily_compact hR C K).of_isClosed_subset isClosed_closure
    (closure_minimal (fun _ hg => hg.regular hf) (regularFamily_closed R C K))

/-- The compact closed orbit remains invariant under every centered left polarization.
Use: compares a maximizing density with its own actual polarization.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: the polarization map is continuous, so it maps a closure into the
closure of its image; finite orbit invariance then gives the asserted inclusion. -/
theorem regularOrbit_polarize {f g : ℝ →ᵇ ℝ} (hg : g ∈ closure {q | RegularOrbit f q})
    {a : ℝ} (ha : 0 ≤ a) : polarizeBCF a g ∈ closure {q | RegularOrbit f q} := by
  apply closure_mono (show polarizeBCF a '' {q | RegularOrbit f q} ⊆ {q | RegularOrbit f q}
    from fun _ ⟨q,hq,h⟩ => h ▸ hq.polarize a ha)
  exact mem_closure_image (polarizeBCF_lipschitz a).continuous.continuousAt hg

/-- Reflection also preserves the closed orbit.
Use: transfers the radial maximizing property to the reflected maximizing density.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: reflection is continuous for the uniform norm and preserves the finite orbit. -/
theorem regularOrbit_mirror {f g : ℝ →ᵇ ℝ} (hg : g ∈ closure {q | RegularOrbit f q}) :
    mirrorBCF g ∈ closure {q | RegularOrbit f q} := by
  apply closure_mono (show mirrorBCF '' {q | RegularOrbit f q} ⊆ {q | RegularOrbit f q}
    from fun _ ⟨q,hq,h⟩ => h ▸ hq.mirror)
  exact mem_closure_image (BoundedContinuousFunction.continuous_compContinuous
    ⟨fun x : ℝ => -x,continuous_neg⟩).continuousAt hg

/-- The strictly radial exponential weight is integrable on the actual real line.
Use: defines a continuous linear test integral on the whole uniform function space.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: on the two half-lines it is exp(x) and exp(-x), respectively. -/
theorem radialWeight_integrable : Integrable (fun x : ℝ => exp (-|x|)) := by
  -- The half-line boundary is retained on the left and excluded on the right.
  have hl : IntegrableOn (fun x : ℝ => exp (-|x|)) (Iic 0) :=
    (integrableOn_exp_Iic 0).congr_fun (fun x hx => by
      rw [abs_of_nonpos hx,neg_neg]) measurableSet_Iic
  have hr : IntegrableOn (fun x : ℝ => exp (-|x|)) (Ioi 0) :=
    (integrableOn_exp_neg_Ioi 0).congr_fun (fun x hx => by
      rw [abs_of_nonneg hx.le]) measurableSet_Ioi
  simpa only [Iic_union_Ioi,integrableOn_univ] using hl.union hr

/-- The weighted radial test integral used to select the rearranged regular density.
Use: a maximizer cannot retain any value inversion that a centered polarization improves.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
-/
def radialIntegral (f : ℝ →ᵇ ℝ) : ℝ := ∫ x, exp (-|x|)*f x

/-- Every bounded continuous function has an absolutely integrable radial test integrand.
Use: legitimate subtraction, reflection and comparison of radial test integrals.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: dominate by the uniform norm times the integrable exponential weight. -/
theorem radialIntegrand_integrable (f : ℝ →ᵇ ℝ) :
    Integrable (fun x => exp (-|x|)*f x) :=
  radialWeight_integrable.mul_bdd f.continuous.aestronglyMeasurable
    (Eventually.of_forall f.norm_coe_le_norm)

/-- The radial test functional is continuous for the uniform norm.
Use: guarantees an actual maximizer on the compact polarization orbit closure.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: its difference is bounded by the uniform distance times the finite
integral of the exponential weight. -/
theorem radialIntegral_continuous : Continuous radialIntegral := by
  -- The Lipschitz estimate holds on the entire function space, without a support restriction.
  let W := ∫ x : ℝ, exp (-|x|)
  have hW : 0 ≤ W := integral_nonneg (fun _ => (exp_pos _).le)
  apply (show LipschitzWith ⟨W,hW⟩ radialIntegral from ?_).continuous
  apply LipschitzWith.of_dist_le_mul
  intro f g
  rw [Real.dist_eq,radialIntegral,radialIntegral,← integral_sub
    (radialIntegrand_integrable f) (radialIntegrand_integrable g)]
  calc
    _ ≤ ∫ x, exp (-|x|)*dist f g := by
      rw [← Real.norm_eq_abs]
      apply norm_integral_le_of_norm_le (radialWeight_integrable.mul_const _)
      apply Eventually.of_forall
      intro x
      rw [Real.norm_eq_abs,← mul_sub,abs_mul,abs_of_pos (exp_pos _)]
      exact mul_le_mul_of_nonneg_left (by
        simpa only [Real.dist_eq] using BoundedContinuousFunction.dist_coe_le_dist (f := f) (g := g) x)
        (exp_pos _).le
    _ = W*dist f g := integral_mul_const _ _

/-- A regular polarization orbit has an actual radial test maximizer.
Use: the existence step in the regular symmetric decreasing rearrangement theorem.
Article: jacobi, Appendix D.1 (full-density rearrangement and radial ground state).
Proof: apply the extreme value theorem to the nonempty compact closed orbit. -/
theorem regularOrbit_maximizer {f : ℝ →ᵇ ℝ} {R C : ℝ} {K : ℝ≥0}
    (hR : 0 ≤ R) (hf : f ∈ regularFamily R C K) :
    ∃ g ∈ closure {q | RegularOrbit f q},
      ∀ q ∈ closure {q | RegularOrbit f q}, radialIntegral q ≤ radialIntegral g := by
  exact (regularOrbit_compact hR hf).exists_isMaxOn
    ⟨f,subset_closure (RegularOrbit.base)⟩ radialIntegral_continuous.continuousOn

end
end jacobi.Rearrangement
