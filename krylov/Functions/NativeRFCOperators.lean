import krylov.Functions.NativeRFCEmbedding
import krylov.Functions.MetricFCSourceBounds

/-!
Article: main_krylov, lem:cycle-transfer, ordinary RFC true segment operators.
Use: derive actual objective-search and correction-gradient oracle identities
from original derivative fields on a metric ball. No prescribed search or
correction secant is an input to these identities.
Source: genuine metric chord existence, stationarity and the segment FTC.
-/
namespace krylov.Functions
noncomputable section
open Set Metric krylov.Methods krylov.Reference krylov.Nonlinear chebyshev1.Nonlinear
open scoped InnerProductSpace NNReal
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The actual physical search average of the native ordinary RFC run.
Article: main_krylov, lem:cycle-transfer. -/
def rfcFunctionSearchOperator (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (H : E → E →L[ℝ] E) (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) : E →L[ℝ] E :=
  let D := rfcFunctionRun T f G memory r x₀ k
  averagedDerivative H (x₀+D.displacement) (rfcFunctionLineStep T f memory r x₀ D)

/-- The actual physical correction average of the native ordinary RFC run.
Article: main_krylov, lem:cycle-transfer. -/
def rfcFunctionCorrectionOperator (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (H : E → E →L[ℝ] E) (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) : E →L[ℝ] E :=
  let D := rfcFunctionRun T f G memory r x₀ k
  averagedDerivative H (rfcFunctionLinePoint T f memory r x₀ D)
    (rfcFunctionCorrectionStep T f G memory r x₀ D)

omit [CompleteSpace E] in
/-- The concrete physical metric search is a genuine chord minimum whenever
its actual input belongs to the original domain. Article: main_krylov, apG:E. -/
theorem metricLocalExactPoint_chord (T : E ≃L[ℝ] E)
    (hT : T.symm.toContinuousLinearMap.IsSymmetric)
    (f : E → ℝ) (G : E → E) (H : E → E →L[ℝ] E)
    {r : ℝ} (hr : 0<r) (hH₀ : coordinateDerivative T H 0=ContinuousLinearMap.id ℝ E)
    {L : ℝ≥0} (hLr : (L : ℝ)*r≤1/2)
    (hH : LipschitzOnWith L (coordinateDerivative T H) (closedBall 0 r))
    (hF : ∀ z : E, ‖T z‖≤r → HasFDerivAt f (innerSL ℝ (G z)) z)
    (hG : ∀ z : E, ‖T z‖≤r → HasFDerivAt G (H z) z)
    (x d : E) (hx : ‖T x‖≤r) :
    IsChordMinimum (coordinateObjective T f) (T x) (T d) r (T (metricLocalExactPoint T f x d r)) := by
  have hFc z (hz : z∈closedBall (0:E) r) := coordinateObjective_hasFDerivAt T hT f G z
    (hF _ (by simpa only [T.apply_symm_apply,mem_closedBall,dist_zero_right] using hz))
  have hGc z (hz : z∈closedBall (0:E) r) := coordinateGradient_hasFDerivAt T G H z
    (hG _ (by simpa only [T.apply_symm_apply,mem_closedBall,dist_zero_right] using hz))
  have hmin := existsUnique_local_chord_minimum (coordinateObjective T f) (coordinateGradient T G)
    (coordinateDerivative T H) hr hH₀ hLr hH hFc hGc (T x) (T d)
    (by simpa only [mem_closedBall,dist_zero_right] using hx)
  simpa only [metricLocalExactPoint,T.apply_symm_apply] using localExactPoint_spec _ _ _ _ hmin

/-- Every native RFC line search has its true search quotient and post-search
gradient. Article: main_krylov, lem:cycle-transfer.
Only the current point's neighborhood is needed; no line-step or secant
identity is assumed. -/
theorem rfcFunctionLine_operator (T : E ≃L[ℝ] E)
    (hT : T.symm.toContinuousLinearMap.IsSymmetric)
    (f : E → ℝ) (G : E → E) (H : E → E →L[ℝ] E)
    {r : ℝ} (hr : 0<r) (hG₀ : G 0=0)
    (hH₀ : coordinateDerivative T H 0=ContinuousLinearMap.id ℝ E)
    {L : ℝ≥0} (hLr : (L : ℝ)*r≤1/2)
    (hH : LipschitzOnWith L (coordinateDerivative T H) (closedBall 0 r))
    (hF : ∀ z : E, ‖T z‖≤r → HasFDerivAt f (innerSL ℝ (G z)) z)
    (hG : ∀ z : E, ‖T z‖≤r → HasFDerivAt G (H z) z)
    (memory : ℕ → ℕ) (x₀ : E) (D : History E)
    (hgrad : D.gradient=G (x₀+D.displacement)) (hx : ‖T (x₀+D.displacement)‖<r/2) :
    let d := rfcFunctionDirection memory D
    let A := averagedDerivative H (x₀+D.displacement) (rfcFunctionLineStep T f memory r x₀ D)
    rfcFunctionLineStep T f memory r x₀ D=lineLength D.gradient d (A d) • d ∧
      G (rfcFunctionLinePoint T f memory r x₀ D)=searchedGradient D.gradient d (A d) := by
  have hchord := metricLocalExactPoint_chord T hT f G H hr hH₀ hLr hH hF hG
    (x₀+D.displacement) (rfcFunctionDirection memory D) (by linarith [norm_nonneg (T (x₀+D.displacement))])
  have he := metric_chord_operator_search T hT f G H hr hG₀ hH₀ hLr hH hF hG
    (x₀+D.displacement) (rfcFunctionDirection memory D) (rfcFunctionLinePoint T f memory r x₀ D) hx hchord
  rw [←hgrad] at he
  exact he

/-- The actual correction-gradient secant is generated by its actual Hessian
average on the real correction segment. Article: main_krylov, lem:cycle-transfer. -/
theorem metric_segment_gradient (T : E ≃L[ℝ] E) (G : E → E) (H : E → E →L[ℝ] E)
    {r : ℝ} {L : ℝ≥0} (hH : LipschitzOnWith L (coordinateDerivative T H) (closedBall 0 r))
    (hG : ∀ z : E, ‖T z‖≤r → HasFDerivAt G (H z) z)
    (a b : E) (ha : ‖T a‖≤r) (hb : ‖T b‖≤r) :
    G b=G a+averagedDerivative H a (b-a) (b-a) := by
  have hseg t (ht : t∈Icc (0:ℝ) 1) : a+t • (b-a)∈T ⁻¹' closedBall (0:E) r := by
    change T (a+t • (b-a))∈closedBall (0:E) r
    rw [map_add,map_smul,map_sub]
    apply (convex_closedBall (0:E) r).add_smul_mem
      (by simpa only [mem_closedBall,dist_zero_right] using ha) _ ht
    simpa only [add_sub_cancel,mem_closedBall,dist_zero_right] using hb
  have hc := (coordinateDerivative_lipschitz_pullback T H hH).continuousOn.comp
    (continuous_const.add (continuous_id.smul continuous_const)).continuousOn hseg
  have he := averagedDerivative_apply G H a (b-a) hc (fun t ht=>hG _
    (by simpa only [mem_preimage,mem_closedBall,dist_zero_right] using hseg t ht))
  rw [add_sub_cancel] at he
  exact (eq_add_of_sub_eq he.symm).trans (add_comm _ _)

/-- A real metric-chord search has a uniform shrinking input-scale enclosure.
Article: main_krylov, lem:cycle-transfer, correction bootstrap search primitive. -/
theorem metricLocalExactPoint_bound (T : E ≃L[ℝ] E)
    (hT : T.symm.toContinuousLinearMap.IsSymmetric)
    (f : E → ℝ) (G : E → E) (H : E → E →L[ℝ] E)
    {r : ℝ} (hr : 0<r) (hG₀ : G 0=0)
    (hH₀ : coordinateDerivative T H 0=ContinuousLinearMap.id ℝ E)
    {L : ℝ≥0} (hLr : (L : ℝ)*r≤1/2)
    (hH : LipschitzOnWith L (coordinateDerivative T H) (closedBall 0 r))
    (hF : ∀ z : E, ‖T z‖≤r → HasFDerivAt f (innerSL ℝ (G z)) z)
    (hG : ∀ z : E, ‖T z‖≤r → HasFDerivAt G (H z) z)
    (x d : E) (hx : ‖T x‖<r/2) :
    ‖T (metricLocalExactPoint T f x d r)‖≤Real.sqrt 3*‖T x‖ ∧
      ‖T (metricLocalExactPoint T f x d r)‖<r := by
  have hFc z (hz : z∈closedBall (0:E) r) := coordinateObjective_hasFDerivAt T hT f G z
    (hF _ (by simpa only [T.apply_symm_apply,mem_closedBall,dist_zero_right] using hz))
  have hGc z (hz : z∈closedBall (0:E) r) := coordinateGradient_hasFDerivAt T G H z
    (hG _ (by simpa only [T.apply_symm_apply,mem_closedBall,dist_zero_right] using hz))
  have hg₀ : coordinateGradient T G 0=0 := by simp only [coordinateGradient,map_zero,hG₀]
  have hchord := metricLocalExactPoint_chord T hT f G H hr hH₀ hLr hH hF hG x d
    (by linarith [norm_nonneg (T x)])
  have hx' : T x∈closedBall (0:E) r := by
    rw [mem_closedBall,dist_zero_right]
    linarith [norm_nonneg (T x)]
  have hvalue := hchord.2.2 0 (by simpa [chordParameters] using hx')
  have hbound := local_sublevel_search_bounds (coordinateObjective T f) (coordinateGradient T G)
    (coordinateDerivative T H) hr hg₀ hH₀ hLr hH hFc hGc (T x)
    (T (metricLocalExactPoint T f x d r)) hx hchord.1 (by simpa only [zero_smul,add_zero] using hvalue)
  exact ⟨hbound.1,by simpa only [mem_ball,dist_zero_right] using hbound.2.2.1⟩

/-- The original physical Hessian average has its true endpoint source bound.
Article: main_krylov, lem:cycle-transfer, actual search and correction inputs. -/
theorem metric_segment_operator_bound (T : E ≃L[ℝ] E) (H : E → E →L[ℝ] E)
    {r : ℝ} (hr : 0≤r) {L : ℝ≥0}
    (hH : LipschitzOnWith L (coordinateDerivative T H) (closedBall 0 r))
    (a b : E) (ha : ‖T a‖≤r) (hb : ‖T b‖≤r) :
    ‖averagedDerivative H a (b-a)-H 0‖≤
      (((‖T.toContinuousLinearMap‖₊^3*L : ℝ≥0) : ℝ))/2*(‖a‖+‖b‖) := by
  have hseg t (ht : t∈Icc (0:ℝ) 1) : a+t • (b-a)∈T ⁻¹' closedBall (0:E) r := by
    change T (a+t • (b-a))∈closedBall (0:E) r
    rw [map_add,map_smul,map_sub]
    apply (convex_closedBall (0:E) r).add_smul_mem
      (by simpa only [mem_closedBall,dist_zero_right] using ha) _ ht
    simpa only [add_sub_cancel,mem_closedBall,dist_zero_right] using hb
  have hphys := coordinateDerivative_lipschitz_pullback T H hH
  have hc := hphys.continuousOn.comp
    (continuous_const.add (continuous_id.smul continuous_const)).continuousOn hseg
  have hz : (0:E)∈T ⁻¹' closedBall (0:E) r := by simp [hr]
  have hc₀ : ContinuousOn (fun t : ℝ=>H ((0:E)+t • (0:E))) (Icc 0 1) := by
    simpa only [smul_zero,add_zero] using
      (continuousOn_const : ContinuousOn (fun _ : ℝ=>H 0) (Icc 0 1))
  have he := averagedHessian_endpoint_bound H a (b-a) 0 0
    (((‖T.toContinuousLinearMap‖₊^3*L : ℝ≥0) : ℝ)) hc hc₀ (NNReal.coe_nonneg _)
    (fun t ht=>by simpa only [smul_zero,add_zero] using hphys.norm_sub_le (hseg t ht) hz)
  simpa [averagedDerivative] using he

end
end krylov.Functions
