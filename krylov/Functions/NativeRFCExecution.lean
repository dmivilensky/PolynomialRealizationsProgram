import krylov.Functions.NativeRFCModel
import krylov.Methods.QuadraticCycles

/-!
Article: main_krylov, alg:fc, lem:cycle-transfer and thm:Htransfer, genuine
ordinary RFC execution on scalar functions.
Use: define the actual physical algorithm with true exact line searches,
actual observed step/secant pairs, the existing latest-model solve, and the
actual gradient evaluation after its correction. No Hessian field, prescribed
operator sequence, reference path or trajectory bound is an algorithm input.
Source: Algorithm FC with one RFC correction and true metric-chord searches.
-/

namespace krylov.Functions
noncomputable section
open krylov.Methods
open scoped Matrix.Norms.L2Operator
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The ordinary RFC physical direction is its existing genuine observed-data rule.
Article: main_krylov, alg:fc. -/
def rfcFunctionDirection (memory : ℕ → ℕ) (H : History E) : E :=
  windowDirection (selectedWindow memory H) H.gradient

/-- The actual exact-search endpoint before the ordinary RFC correction.
Article: main_krylov, alg:fc and apG:E. -/
def rfcFunctionLinePoint (T : E ≃L[ℝ] E) (f : E → ℝ) (memory : ℕ → ℕ)
    (r : ℝ) (x₀ : E) (H : History E) : E :=
  metricLocalExactPoint T f (x₀+H.displacement) (rfcFunctionDirection memory H) r

/-- The actual evaluated line-search step, before the correction query.
Article: main_krylov, alg:fc. -/
def rfcFunctionLineStep (T : E ≃L[ℝ] E) (f : E → ℝ) (memory : ℕ → ℕ)
    (r : ℝ) (x₀ : E) (H : History E) : E :=
  rfcFunctionLinePoint T f memory r x₀ H-(x₀+H.displacement)

/-- The genuine observed gate of ordinary RFC on its true retained pair window.
Article: main_krylov, alg:fc. -/
def rfcFunctionGate (memory : ℕ → ℕ) (H : History E) : Prop :=
  selectedWindow memory H≠[] ∧ ‖windowDefect (selectedWindow memory H)‖<1

/-- The actual ordinary RFC correction, computed only from true observed data.
Its newest model column is the actual evaluated line step and gradient secant.
Article: main_krylov, alg:fc, ordinary RFC with one true correction query. -/
def rfcFunctionCorrectionStep (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (H : History E) : E := by
  classical
  let y := rfcFunctionLinePoint T f memory r x₀ H
  let s := rfcFunctionLineStep T f memory r x₀ H
  let U := (s,G y-H.gradient)::selectedWindow memory H
  exact if rfcFunctionGate memory H then
    combine (windowSteps U) (modelCoefficients (windowSteps U) (windowModel U) (G y)) else 0

/-- One complete actual ordinary RFC record, retaining every true correction
query and true returned gradient. Article: main_krylov, alg:fc. -/
def rfcFunctionRecord (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (H : History E) : IterationRecord E := by
  classical
  let y := rfcFunctionLinePoint T f memory r x₀ H
  let s := rfcFunctionLineStep T f memory r x₀ H
  let u := rfcFunctionCorrectionStep T f G memory r x₀ H
  let d := rfcFunctionDirection memory H
  let α := observedLineParameter d s
  exact ⟨d,α⁻¹ • (G y-H.gradient),s+u,G (y+u),
    if rfcFunctionGate memory H then [(u,G (y+u))] else []⟩

/-- The complete ordinary RFC observed history generated by real objective
searches and actual gradient queries.
Article: main_krylov, lem:cycle-transfer and thm:Htransfer. -/
def rfcFunctionRun (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) : ℕ → History E
  | 0 => ⟨G x₀,[]⟩
  | k+1 =>
      let H := rfcFunctionRun T f G memory r x₀ k
      ⟨H.initial,rfcFunctionRecord T f G memory r x₀ H::H.records⟩

/-- The actual physical point of the native ordinary RFC execution.
Article: main_krylov, lem:cycle-transfer. -/
def rfcFunctionPoint (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) : E :=
  x₀+(rfcFunctionRun T f G memory r x₀ k).displacement

/-- Each actual record's gradient is evaluated at its actual full endpoint.
Article: main_krylov, alg:fc, ordinary RFC functional oracle semantics. -/
theorem rfcFunctionRecord_gradient (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (H : History E) :
    (rfcFunctionRecord T f G memory r x₀ H).gradient=
      G (x₀+H.displacement+(rfcFunctionRecord T f G memory r x₀ H).step) := by
  simp only [rfcFunctionRecord]
  congr 1
  unfold rfcFunctionLineStep
  abel

/-- The next physical point is the current point plus its actual recorded total step.
Article: main_krylov, alg:fc. -/
theorem rfcFunctionPoint_succ (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) :
    rfcFunctionPoint T f G memory r x₀ (k+1)=rfcFunctionPoint T f G memory r x₀ k+
      (rfcFunctionRecord T f G memory r x₀ (rfcFunctionRun T f G memory r x₀ k)).step := by
  simp only [rfcFunctionPoint,rfcFunctionRun,History.displacement,List.map_cons,List.sum_cons]
  abel

/-- Every complete actual native history stores precisely the true current gradient.
Article: main_krylov, lem:cycle-transfer, no assumed operator transcript. -/
theorem rfcFunctionRun_gradient (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) :
    (rfcFunctionRun T f G memory r x₀ k).gradient=G (rfcFunctionPoint T f G memory r x₀ k) := by
  cases k with
  | zero => simp [rfcFunctionRun,rfcFunctionPoint,History.displacement,History.gradient]
  | succ k =>
    rw [rfcFunctionRun]
    change (rfcFunctionRecord T f G memory r x₀ (rfcFunctionRun T f G memory r x₀ k)).gradient=_
    rw [rfcFunctionRecord_gradient]
    congr 1
    simp only [rfcFunctionPoint,rfcFunctionRun,History.displacement,List.map_cons,List.sum_cons]
    abel

/-- All genuine finite histories retain their actual original gradient observation.
Article: main_krylov, lem:cycle-transfer. -/
theorem rfcFunctionRun_initial (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) :
    (rfcFunctionRun T f G memory r x₀ k).initial=G x₀ := by
  induction k with
  | zero => rfl
  | succ k ih => exact ih

/-- The native ordinary RFC history clock equals the actual iteration count.
Article: main_krylov, lem:cycle-transfer. -/
theorem rfcFunctionRun_length (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) :
    (rfcFunctionRun T f G memory r x₀ k).records.length=k := by
  induction k with
  | zero => rfl
  | succ k ih => simpa only [rfcFunctionRun,List.length_cons] using congrArg Nat.succ ih

/-- The actual data-only direction is exactly the existing ordinary RFC policy direction.
Article: main_krylov, alg:fc, faithful native implementation dictionary. -/
theorem rfcFunction_direction_policy (memory : ℕ → ℕ) (H : History E) :
    (rfcMethod memory 1).direction H=rfcFunctionDirection memory H := rfl

/-- The actual corrected native point is the actual searched point plus the
actual correction query. Article: main_krylov, alg:fc. -/
theorem rfcFunctionPoint_succ_line (T : E ≃L[ℝ] E) (f : E → ℝ) (G : E → E)
    (memory : ℕ → ℕ) (r : ℝ) (x₀ : E) (k : ℕ) :
    rfcFunctionPoint T f G memory r x₀ (k+1)=
      rfcFunctionLinePoint T f memory r x₀ (rfcFunctionRun T f G memory r x₀ k)+
        rfcFunctionCorrectionStep T f G memory r x₀ (rfcFunctionRun T f G memory r x₀ k) := by
  rw [rfcFunctionPoint_succ]
  change x₀+(rfcFunctionRun T f G memory r x₀ k).displacement+
    (rfcFunctionLineStep T f memory r x₀ (rfcFunctionRun T f G memory r x₀ k)+_)=_
  unfold rfcFunctionLineStep
  abel

end
end krylov.Functions
