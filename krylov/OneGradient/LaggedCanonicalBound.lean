import krylov.OneGradient.LaggedJointRemainder
set_option autoImplicit false
/-!
Article: main_krylov, prop:hb(a), full canonical increment norm bound.
Use: prove the actual O(norm(E)^2) assertion on the entire original finite
symmetric increment class, with its genuine n+1-gradient cost.
Source: the proved native lagged joint remainder, original canonical root
congruences and a linear symmetric continuation of the finite input chart.
-/

namespace krylov.OneGradient
noncomputable section
open Matrix krylov.Methods krylov.Reference krylov.Stability krylov.Secant krylov.LinearAlgebra
open scoped BigOperators Matrix.Norms.L2Operator
variable {n : ℕ}

/-- The actual physical operators generated by all n original canonical
increments, including the final unevaluated output segment.
Use: the input norm is exactly the maximum spectral norm of these increments.
Article: main_krylov, prop:hb(a). -/
def laggedCanonicalMatrices (base : Matrix (Fin n) (Fin n) ℝ)
    (E : Fin n → Matrix (Fin n) (Fin n) ℝ) (k : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  base+metricRoot base*(∑ i : Fin n,if i.val<k then E i else 0)*metricRoot base

/-- On every constant-length reference, arbitrary positive lagged
initialization gives a genuine uniform quadratic error in the maximum norm
of the complete original symmetric increment family, using n+1 gradients.
Use: this is the source norm statement, including the free output operator,
with no path, trial-regularity or assumed remainder premise.
Article: main_krylov, prop:hb(a).
Proof: symmetrization gives a smooth full finite-dimensional parameter chart
equal to the original operators on every actual symmetric input. The true
native joint bound and exact one-gradient count apply to that same execution. -/
theorem lagged_constant_canonical_bound (directions : Bool) {tau0 : ℝ} (htau0 : 0<tau0)
    (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hc : referenceAtomCount base hb g=n) (hn : 2≤n)
    (alpha : ℝ) (halpha : ∀ i<n,CG.length (cgOperator base) g i=alpha) :
    let method := xrfcBasisMethod directions (laggedTrial directions tau0)
    ∃ delta C : ℝ,0<delta ∧ 0≤C ∧
      ∀ E : Fin n → Matrix (Fin n) (Fin n) ℝ,(∀ i,(E i).IsSymm) → ‖E‖≤delta →
        let op := fun k => cgOperator (laggedCanonicalMatrices base E k)
        ‖cgOperator (metricRoot base)⁻¹
          (method.outputGradient (op n) (oneGradientRun method op g n))‖≤
            C*‖E‖^2*‖cgOperator (metricRoot base)⁻¹ g‖ ∧
          oneGradientCost (oneGradientRun method op g n)=n+1 := by
  let X := Fin n → Matrix (Fin n) (Fin n) ℝ
  let sym : X → X := fun E i => (1/2:ℝ) • (E i+(E i)ᵀ)
  let A : X → ℕ → Matrix (Fin n) (Fin n) ℝ := fun E => laggedCanonicalMatrices base (sym E)
  have hentry (i a b : Fin n) : ContDiffAt ℝ 2 (fun E : X => E i a b) 0 := by
    have hi : ContDiffAt ℝ 2 (fun E : X => E i) 0 := contDiffAt_pi.mp contDiffAt_id i
    have he := (matrixEntryEquiv n n).toContinuousLinearMap.contDiff.contDiffAt.comp 0 hi
    exact contDiffAt_pi.mp he (a,b)
  have hsymreg (i : Fin n) : ContDiffAt ℝ 2 (fun E : X => sym E i) 0 := by
    apply contDiff_spectral_matrix
    intro a b
    exact contDiffAt_const.mul ((hentry i a b).add (hentry i b a))
  have hA (k : ℕ) : ContDiffAt ℝ 2 (fun E : X => A E k) 0 := by
    have hsum : ContDiffAt ℝ 2 (fun E : X => ∑ i : Fin n,if i.val<k then sym E i else 0) 0 := by
      apply ContDiffAt.sum
      intro i _
      split_ifs
      · exact hsymreg i
      · exact contDiffAt_const
    exact contDiffAt_const.add ((contDiffAt_const.mul hsum).mul contDiffAt_const)
  have hsym (E : X) (k : ℕ) : (A E k).IsSymm := by
    have hs (i : Fin n) : (sym E i).IsSymm := by
      simp only [sym,Matrix.IsSymm,Matrix.transpose_smul,Matrix.transpose_add,Matrix.transpose_transpose,add_comm]
    have ht : (∑ i : Fin n,if i.val<k then sym E i else 0).IsSymm := by
      rw [Matrix.IsSymm,Matrix.transpose_sum]
      apply Finset.sum_congr rfl
      intro i _
      split_ifs
      · exact (hs i).eq
      · exact Matrix.transpose_zero
    change (base+metricRoot base*(∑ i : Fin n,if i.val<k then sym E i else 0)*metricRoot base).IsSymm
    rw [Matrix.IsSymm,Matrix.transpose_add,Matrix.transpose_mul,Matrix.transpose_mul,
      hb.1.isSymm.eq,(metricRoot_isSymm base).eq,ht.eq,Matrix.mul_assoc]
  have hA0 (k : ℕ) : A 0 k=base := by
    change base+metricRoot base*(∑ i : Fin n,if i.val<k then
      (1/2:ℝ) • ((0 : Matrix (Fin n) (Fin n) ℝ)+0ᵀ) else 0)*metricRoot base=base
    simp
  obtain ⟨delta,C,hd,hC,hbound⟩ := lagged_constant_output_joint directions htau0
    base hb g hc hn alpha halpha A hA hsym hA0
  refine ⟨delta,C,hd,hC,?_⟩
  intro E hE hsmall
  have heq : sym E=E := by
    funext i
    dsimp only [sym]
    rw [(hE i).eq]
    module
  have hout := hbound E hsmall
  change ‖cgOperator (metricRoot base)⁻¹
    ((xrfcBasisMethod directions (laggedTrial directions tau0)).outputGradient
      (cgOperator (laggedCanonicalMatrices base (sym E) n))
      (oneGradientRun (xrfcBasisMethod directions (laggedTrial directions tau0))
        (fun k => cgOperator (laggedCanonicalMatrices base (sym E) k)) g n))‖≤_ at hout
  rw [heq] at hout
  exact ⟨hout,oneGradientCost_run _ _ g n⟩

/-- Every original heavy-ball-measure reference of dimension at least two
has the full native lagged quadratic norm guarantee and n+1-gradient cost.
Use: closes the original physical-measure statement with its actual policy.
Article: main_krylov, prop:hb(a).
Proof: actual equality of the original spectral probabilities gives constant
measured CG lengths; the proved entire canonical increment bound then applies. -/
theorem lagged_heavyBall_canonical_bound (directions : Bool) {tau0 : ℝ} (htau0 : 0<tau0)
    (I : chebyshev1.SpectralInterval) (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) (hc : referenceAtomCount base hb g=n) (hn : 2≤n)
    (hmeasure : ∀ f,gradientSpectralIntegral base hb g hg f=heavyBallSpectralIntegral I n (by omega) f) :
    let method := xrfcBasisMethod directions (laggedTrial directions tau0)
    ∃ delta C : ℝ,0<delta ∧ 0≤C ∧
      ∀ E : Fin n → Matrix (Fin n) (Fin n) ℝ,(∀ i,(E i).IsSymm) → ‖E‖≤delta →
        let op := fun k => cgOperator (laggedCanonicalMatrices base E k)
        ‖cgOperator (metricRoot base)⁻¹
          (method.outputGradient (op n) (oneGradientRun method op g n))‖≤
            C*‖E‖^2*‖cgOperator (metricRoot base)⁻¹ g‖ ∧
          oneGradientCost (oneGradientRun method op g n)=n+1 :=
  lagged_constant_canonical_bound directions htau0 base hb g hc hn _
    (fun i hi => (heavyBall_measure_coefficients I (by omega) base hb g hg hmeasure i hi).1)

end
end krylov.OneGradient
