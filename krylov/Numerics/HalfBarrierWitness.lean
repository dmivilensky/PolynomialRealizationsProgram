    (3194588843389863 / 100000000000000000000) * v ^ 10 +
    (-369763460170833 / 25000000000000000000) * v ^ 11 +
    (20264492713329 / 4000000000000000000) * v ^ 12 +
    (-6229268517781 / 5000000000000000000) * v ^ 13 +
    (10414529642363 / 50000000000000000000) * v ^ 14 +
    (-2123338103989 / 100000000000000000000) * v ^ 15 +
    (99989154827 / 100000000000000000000) * v ^ 16

/-- Its literal derivative. -/
def halfCertifiedPDerivative (v : ℝ) : ℝ :=
    (38687552798161551 / 3125000000000000000) * v ^ 0 +
    (28858827363814351 / 10000000000000000000) * v ^ 1 +
    (32133361169744373 / 50000000000000000000) * v ^ 2 +
    (4336056614927339 / 25000000000000000000) * v ^ 3 +
    (-1319363149807767 / 20000000000000000000) * v ^ 4 +
    (309190952152749 / 1250000000000000000) * v ^ 5 +
    (-20355582575346263 / 50000000000000000000) * v ^ 6 +
    (3174267932260883 / 6250000000000000000) * v ^ 7 +
    (-46621307299084407 / 100000000000000000000) * v ^ 8 +
    (3194588843389863 / 10000000000000000000) * v ^ 9 +
    (-4067398061879163 / 25000000000000000000) * v ^ 10 +
    (60793478139987 / 1000000000000000000) * v ^ 11 +
    (-80980490731153 / 5000000000000000000) * v ^ 12 +
    (72901707496541 / 25000000000000000000) * v ^ 13 +
    (-6370014311967 / 20000000000000000000) * v ^ 14 +
    (99989154827 / 6250000000000000000) * v ^ 15

/-- Exact differentiation of the rational witness polynomial. -/
theorem halfCertifiedP_hasDerivAt (v : ℝ) :
    HasDerivAt halfCertifiedP (halfCertifiedPDerivative v) v := by
  have h0 := ((hasDerivAt_id v).pow 0).const_mul (4357652264175033459 / 12500000000000000000)
  have h1 := h0.add (((hasDerivAt_id v).pow 1).const_mul (38687552798161551 / 3125000000000000000))
  have h2 := h1.add (((hasDerivAt_id v).pow 2).const_mul (28858827363814351 / 20000000000000000000))
  have h3 := h2.add (((hasDerivAt_id v).pow 3).const_mul (10711120389914791 / 50000000000000000000))
  have h4 := h3.add (((hasDerivAt_id v).pow 4).const_mul (4336056614927339 / 100000000000000000000))
  have h5 := h4.add (((hasDerivAt_id v).pow 5).const_mul (-1319363149807767 / 100000000000000000000))
  have h6 := h5.add (((hasDerivAt_id v).pow 6).const_mul (103063650717583 / 2500000000000000000))
  have h7 := h6.add (((hasDerivAt_id v).pow 7).const_mul (-2907940367906609 / 50000000000000000000))
  have h8 := h7.add (((hasDerivAt_id v).pow 8).const_mul (3174267932260883 / 50000000000000000000))
  have h9 := h8.add (((hasDerivAt_id v).pow 9).const_mul (-5180145255453823 / 100000000000000000000))
  have h10 := h9.add (((hasDerivAt_id v).pow 10).const_mul (3194588843389863 / 100000000000000000000))
  have h11 := h10.add (((hasDerivAt_id v).pow 11).const_mul (-369763460170833 / 25000000000000000000))
  have h12 := h11.add (((hasDerivAt_id v).pow 12).const_mul (20264492713329 / 4000000000000000000))
  have h13 := h12.add (((hasDerivAt_id v).pow 13).const_mul (-6229268517781 / 5000000000000000000))
  have h14 := h13.add (((hasDerivAt_id v).pow 14).const_mul (10414529642363 / 50000000000000000000))
  have h15 := h14.add (((hasDerivAt_id v).pow 15).const_mul (-2123338103989 / 100000000000000000000))
  have h16 := h15.add (((hasDerivAt_id v).pow 16).const_mul (99989154827 / 100000000000000000000))
  convert h16 using 1
  · rfl
  · norm_num [halfCertifiedPDerivative]
    ring

/-- Upper and lower witnesses, encoded by sign=1 and sign=-1 respectively. -/
def halfCertifiedBarrier (sign U : ℝ) : ℝ :=
  3 - (4-U) * (halfCertifiedP (4-U) - sign / 10000000)

/-- Literal derivative of the signed witness. -/
def halfCertifiedBarrierDerivative (sign U : ℝ) : ℝ :=
  halfCertifiedP (4-U) - sign / 10000000 + (4-U) * halfCertifiedPDerivative (4-U)

/-- Exact derivative of each numerical barrier. -/
theorem halfCertifiedBarrier_hasDerivAt (sign U : ℝ) :
    HasDerivAt (halfCertifiedBarrier sign) (halfCertifiedBarrierDerivative sign U) U := by
  have hv := (hasDerivAt_id U).const_sub 4
  have hp := ((halfCertifiedP_hasDerivAt (4-U)).comp U hv).sub_const (sign / 10000000)
  convert (hv.mul hp).const_sub 3 using 1
  · rfl
  · dsimp [halfCertifiedBarrierDerivative]
    ring

@[simp] theorem halfCertifiedBarrier_four (sign : ℝ) : halfCertifiedBarrier sign 4 = 3 := by
  simp [halfCertifiedBarrier]

