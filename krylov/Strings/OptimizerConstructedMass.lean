import krylov.Strings.OptimizerPhysicalExtension
import krylov.Strings.Reward

/-!
Article: main_krylov, thm:value, actual global optimizer mass and reward.
Use: realize the globally constructed physical quadratures as one genuine
Stieltjes mass and identify its actual state, RN type clock and reward density.
Source: global continuous-density mass construction and exact compact locality.
-/

namespace krylov.Strings.OptimizerQuadratures
noncomputable section
open Set Filter MeasureTheory
open scoped Topology NNReal

/-- The global mass actually generated by the inverse-clock construction. -/
def constructedMass (s : ℝ → ℝ) (hs : Continuous s) (hp : ∀ t, 0 < s t)
    (h₁ : ∀ t ≥ 0, 1 ≤ s t) : Mass :=
  OptimizerDensity.globalMass (extendedDensity s) (extendedDensity_continuous hs hp h₁)

/-- Positive orbit control gives a strictly positive extended physical density. -/
theorem extendedDensity_pos {s : ℝ → ℝ} (hp : ∀ t, 0 < s t) (x : ℝ) :
    0 < extendedDensity s x := by
  exact div_pos (Real.exp_pos _) (mul_pos (expPrimitive_pos _ _) (Real.sqrt_pos.mpr (hp _)))

/-- The extended physical coordinates preserve the unit initial state. -/
theorem extended_initial {s U : ℝ → ℝ} (hs : Continuous s) (hp : ∀ t, 0 < s t) :
    extendedPosition s 0 = 1 ∧ extendedSlope s 0 = 1 ∧ extendedEnergy s U 0 = 1 := by
  obtain ⟨hφ, hP, hK, _⟩ := extended_coordinates_eq (U := U) hs hp (x := 0) le_rfl
  rw [hφ, hP, hK]
  exact physical_initial hs hp

/-- The actual global Stieltjes mass and the actual global physical state
satisfy all three printed integral equations at every physical position. -/
theorem constructedMass_state {s U : ℝ → ℝ} (hs : Continuous s) (hU : Continuous U)
    (hp : ∀ t, 0 < s t) (h₁ : ∀ t ≥ 0, 1 ≤ s t) (hU₀ : U 0 = 1)
    (hode : ∀ t > 0, HasDerivAt U (U t * (s t + 1 - U t)) t)
    {x : ℝ} (hx : 0 ≤ x) :
    extendedPosition s x = 1 + ∫ t in Ioc 0 x, extendedSlope s t ∧
      extendedSlope s x = integralSlope (constructedMass s hs hp h₁).measure (extendedPosition s) x ∧
      extendedEnergy s U x = integralEnergy (constructedMass s hs hp h₁).measure (extendedPosition s) x := by
  let L : ℝ≥0 := ⟨x, hx⟩
  have hc := extendedDensity_continuous hs hp h₁
  obtain ⟨hφ₀, hP₀, hK₀⟩ := extended_initial (U := U) hs hp
  have he := OptimizerDensity.state_integral_equations (extendedDensity s) hc L hφ₀ hP₀ hK₀
    (fun t ht ↦ extended_smoothStringAt hs hU hp h₁ hU₀ hode ht.1)
    (show x ∈ Icc 0 (L : ℝ) from ⟨hx, le_rfl⟩)
  have hμ := OptimizerDensity.globalMass_restrict_compact (extendedDensity s) hc L
  change (constructedMass s hs hp h₁).measure.restrict (Ioc 0 x) =
    (OptimizerDensity.mass (extendedDensity s) hc L).measure.restrict (Ioc 0 x) at hμ
  dsimp [integralSlope, integralEnergy] at he ⊢
  rw [hμ]
  exact he

/-- The RN-defined type density of the constructed global mass agrees with
the physical density on every finite window, including correct null sets. -/
theorem constructedMass_typeDensity {s : ℝ → ℝ} (hs : Continuous s)
    (hp : ∀ t, 0 < s t) (h₁ : ∀ t ≥ 0, 1 ≤ s t) (L : ℝ≥0) :
    (constructedMass s hs hp h₁).typeDensity =ᵐ[volume.restrict (Ioc 0 (L : ℝ))] extendedDensity s := by
  filter_upwards [OptimizerDensity.global_typeDensity_eq_abs_ae (extendedDensity s)
    (extendedDensity_continuous hs hp h₁) L] with x hx
  exact hx.trans (abs_of_pos (extendedDensity_pos hp x))

/-- The actual type clock of the constructed global mass is its genuine
physical feedback integral. -/
theorem constructedMass_typeClock {s : ℝ → ℝ} (hs : Continuous s)
    (hp : ∀ t, 0 < s t) (h₁ : ∀ t ≥ 0, 1 ≤ s t) {x : ℝ} (hx : 0 ≤ x) :
    (constructedMass s hs hp h₁).typeClock x = ∫ t in (0 : ℝ)..x, extendedDensity s t :=
  OptimizerDensity.global_typeClock_eq_integral (extendedDensity s)
    (extendedDensity_continuous hs hp h₁) (fun t _ ↦ (extendedDensity_pos hp t).le) hx

/-- The article's actual mass-based endpoint reward has the exact smooth
density of the constructed physical state on every finite window. -/
theorem constructedMass_rewardDensity {s U : ℝ → ℝ} (hs : Continuous s) (hU : Continuous U)
    (hp : ∀ t, 0 < s t) (h₁ : ∀ t ≥ 0, 1 ≤ s t) (hU₀ : U 0 = 1)
    (hode : ∀ t > 0, HasDerivAt U (U t * (s t + 1 - U t)) t) (L : ℝ≥0) :
    (constructedMass s hs hp h₁).rewardDensity 1 (extendedPosition s) =ᵐ[
      volume.restrict (Ioc 0 (L : ℝ))]
      fun x ↦ (extendedEnergy s U x)⁻¹ * extendedDensity s x := by
  filter_upwards [constructedMass_typeDensity hs hp h₁ L,
    ae_restrict_mem measurableSet_Ioc] with x hx hxm
  obtain ⟨_, _, hK⟩ := constructedMass_state hs hU hp h₁ hU₀ hode hxm.1.le
  dsimp [Mass.rewardDensity]
  rw [← hK, hx, Real.rpow_neg_one]

end
end krylov.Strings.OptimizerQuadratures
