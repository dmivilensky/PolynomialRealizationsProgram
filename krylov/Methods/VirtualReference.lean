import krylov.Methods.CGFlags

/-!
Article: main_krylov, lem:consistent(b), basis-independent virtual reference comparison.
Use: identify the actual computed virtual point, gradient and direction from
the actual stored basis and true quadratic observations, ready for execution induction.
Source: uniqueness of the actual positive Galerkin solve and computed CG conjugacy.
-/

namespace krylov.Methods
noncomputable section
open Matrix krylov.Reference
open scoped InnerProductSpace BigOperators
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The actual physical span generated by a stored pair window.
Use: basis invariants refer to exactly the vectors supplied to the real coefficient solve.
Article: main_krylov, lem:consistent(b), span S_k. -/
def pairSpan (W : List (E × E)) : Submodule ℝ E := Submodule.span ℝ (Set.range (windowSteps W))

omit [InnerProductSpace ℝ E] [NormedAddCommGroup E] in
/-- The actual step family range equals the physical first components of the actual stored entries.
Use: connect actual recorded displacement sums to the finite coefficient model basis.
Article: main_krylov, alg:xrfc, stored steps.
Proof: every finite index selects a real list entry, and every real member has such an index. -/
theorem windowSteps_range (W : List (E × E)) :
    Set.range (windowSteps W)=Prod.fst '' {p | p∈W} := by
  ext v
  constructor
  · rintro ⟨i,rfl⟩
    exact ⟨W.get i,List.get_mem W i,rfl⟩
  · rintro ⟨p,hp,rfl⟩
    obtain ⟨i,hi⟩ := List.mem_iff_get.mp hp
    exact ⟨i,congrArg Prod.fst hi⟩

/-- Appending an actual newest pair extends its physical span by exactly the new recorded step.
Use: actual XRFC trial-span growth is a theorem about its real stored window.
Article: main_krylov, lem:consistent(b), append actual step.
Proof: the actual finite step family is a head-cons family and its span splits at that head. -/
theorem pairSpan_cons (p : E × E) (W : List (E × E)) :
    pairSpan (p::W)=(ℝ ∙ p.1)⊔pairSpan W := by
  rw [pairSpan, windowSteps_cons, Fin.range_cons, Submodule.span_insert]
  rfl

omit [InnerProductSpace ℝ E] in
/-- Full retention selects the complete actual pair transcript.
Use: the virtual-launch induction uses the exact implemented full-memory policy.
Article: main_krylov, lem:consistent(b), full memory.
Proof: actual pair extraction preserves the actual record count. -/
theorem selectedWindow_full (H : History E) : selectedWindow fullMemory H=H.pairs := by
  change H.pairs.take H.records.length=H.pairs
  rw [← H.pairs_length, List.take_length]

/-- The actual accumulated displacement belongs to the span of the actual recorded step family.
Use: the evaluated point lies in the affine space generated by its real stored full-memory steps.
Article: main_krylov, lem:consistent(b), x_k∈x₀+span S_k.
Proof: actual pair extraction preserves the step list; every summand is a genuine window generator. -/
theorem History.displacement_mem_pairSpan (H : History E) : H.displacement∈pairSpan H.pairs := by
  rw [History.displacement, ← H.pairs_steps]
  apply list_sum_mem
  intro v hv
  obtain ⟨p,hp,rfl⟩ := List.mem_map.mp hv
  apply Submodule.subset_span
  rw [windowSteps_range]
  exact ⟨p,hp,rfl⟩

/-- The actual block solve on any independent basis of the true old CG flag gives the actual current CG direction.
Use: the step basis need not consist of conjugate or orthogonal vectors.
Article: main_krylov, lem:consistent(b), virtual full-conjugacy direction.
Proof: the candidate CG direction has its negative-gradient correction in the
same actual flag and annihilates every actual old operator image; computed inverse uniqueness applies. -/
theorem windowDirection_reference_basis (W : List (E × E)) (Q : E →L[ℝ] E)
    (hQ : Q.toLinearMap.IsSymmetric) (hpos : ∀ v : E, v≠0 → 0 < inner ℝ v (Q v))
    (g : E) (k : ℕ) (hg : ∀ i<k, CG.gradient Q g i≠0)
    (hy : ∀ i, windowImages W i=Q (windowSteps W i)) (hs : LinearIndependent ℝ (windowSteps W))
    (hspan : pairSpan W=directionFlag Q g k) :
    windowDirection W (CG.gradient Q g k)=CG.direction Q g k := by
  -- Characterize the actual computed block direction on the true stored physical basis.
  have hmat : crossGram (windowImages W) (windowSteps W)=crossGram (fun i => Q (windowSteps W i)) (windowSteps W) := by
    congr 1
    exact funext hy
  apply conjugacyDirection_unique
  · rw [hmat]
    exact isUnit_iff_ne_zero.mpr (operatorGram_posDef Q hQ hpos hs).det_pos.ne'
  · change _∈pairSpan W
    rw [hspan]
    exact direction_add_gradient_mem_flag Q g k
  · ext i
    change inner ℝ (windowImages W i) (CG.direction Q g k)=0
    rw [hy]
    have he := hQ (windowSteps W i) (CG.direction Q g k)
    change inner ℝ (Q (windowSteps W i)) (CG.direction Q g k)=
      inner ℝ (windowSteps W i) (Q (CG.direction Q g k)) at he
    rw [he]
    apply directionFlag_conjugate Q hQ hpos g k hg
    rw [← hspan]
    exact Submodule.subset_span ⟨i,rfl⟩

/-- The actual virtual solve on a complete independent stored CG flag returns the true reference point, gradient and direction.
Use: this is the execution induction step, with only actual oracle balance and an actual stored-basis invariant as premises.
Article: main_krylov, lem:consistent(b), actual virtual reference identities.
Proof: the true reference displacement difference is in the actual stored span;
its true gradient is the unique Galerkin residual, and computed conjugacy gives its true CG direction. -/
theorem virtual_reference_basis (H : History E) (Q : E →L[ℝ] E)
    (hQ : Q.toLinearMap.IsSymmetric) (hpos : ∀ v : E, v≠0 → 0 < inner ℝ v (Q v))
    (g : E) (k : ℕ) (hg : ∀ i<k, CG.gradient Q g i≠0)
    (hbal : H.gradient=g+Q H.displacement)
    (hy : ∀ i, windowImages H.pairs i=Q (windowSteps H.pairs i))
    (hs : LinearIndependent ℝ (windowSteps H.pairs)) (hspan : pairSpan H.pairs=directionFlag Q g k) :
    virtualCorrection H.pairs H.gradient=CG.displacement Q g k-H.displacement ∧
      virtualGradient H.pairs H.gradient=CG.gradient Q g k ∧
      windowDirection H.pairs (virtualGradient H.pairs H.gradient)=CG.direction Q g k := by
  -- The candidate correction is a difference of two actual points in the same proven physical flag.
  have hu : CG.displacement Q g k-H.displacement∈pairSpan H.pairs := by
    apply Submodule.sub_mem
    · rw [hspan]; exact displacement_mem_directionFlag Q g k
    · exact H.displacement_mem_pairSpan
  have hgrad : H.gradient+Q (CG.displacement Q g k-H.displacement)=CG.gradient Q g k := by
    rw [hbal, map_sub, CG.gradient_displacement]
    abel
  have ho : coordinates (windowSteps H.pairs) (H.gradient+Q (CG.displacement Q g k-H.displacement))=0 := by
    rw [hgrad]
    ext i
    apply directionFlag_gradient_orthogonal Q hQ hpos g k hg
    rw [← hspan]
    exact Submodule.subset_span ⟨i,rfl⟩
  have hc := virtualCorrection_unique H.pairs Q hQ hpos hy hs H.gradient _ hu ho
  have hv : virtualGradient H.pairs H.gradient=CG.gradient Q g k := by
    rw [virtualGradient_quadratic H.pairs Q H.gradient hy, hc, hgrad]
  exact ⟨hc,hv,by rw [hv]; exact windowDirection_reference_basis H.pairs Q hQ hpos g k hg hy hs hspan⟩

end
end krylov.Methods
