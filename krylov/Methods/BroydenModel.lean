import krylov.Methods.BroydenUpdate
import krylov.Methods.InformationSpan

set_option autoImplicit false
/-!
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Use: build the genuine inverse secant models from observed pairs only and verify true all-history information admissibility of their real correction-free directions.
Source: the actual DFP/BFGS endpoint linear maps, chronological secant-update recursion and genuine observed-vector span restrictions.
-/

namespace krylov.Methods
noncomputable section
open krylov.Reference
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The actual inverse convex Broyden model starts at the genuine scalar identity and applies true chronological observed secant updates.
Use: The actual inverse convex Broyden model starts at the genuine scalar identity and applies true chronological observed secant updates.
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Proof: Recurse through the actual newest-first pair list, using the genuine older model and fixed chronological interpolation parameters. -/
def inverseBroydenModel (c : ℝ) (θ : ℕ → ℝ) : List (E × E) → E →ₗ[ℝ] E
  | [] => c • LinearMap.id
  | (s,y)::W => inverseBroydenUpdate (inverseBroydenModel c θ W) s y (θ W.length)

/-- The genuine full-memory convex Broyden policy chooses the negative actual inverse-model gradient and makes no correction queries.
Use: The genuine full-memory convex Broyden policy chooses the negative actual inverse-model gradient and makes no correction queries.
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Proof: The true model is built entirely from genuine observed secant pairs and fixed prior scalar parameters. -/
def broydenMethod (c : ℝ) (θ : ℕ → ℝ) : ProbedMethod E where
  direction H := -inverseBroydenModel c θ H.pairs H.gradient
  correction _ _ := .done

/-- The genuine empty observed Broyden model is exactly the actual scalar identity action.
Use: The genuine empty observed Broyden model is exactly the actual scalar identity action.
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Proof: Read the real initial model definition. -/
theorem inverseBroydenModel_nil (c : ℝ) (θ : ℕ → ℝ) (v : E) :
    inverseBroydenModel c θ [] v=c • v := rfl

/-- Every true Broyden model action stays in a genuine subspace containing its actual input and observed pair vectors.
Use: Every true Broyden model action stays in a genuine subspace containing its actual input and observed pair vectors.
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Proof: Induct through the actual chronological endpoint updates; every true rank-one term is a genuine combination of retained vectors and older model actions. -/
theorem inverseBroydenModel_apply_mem (c : ℝ) (θ : ℕ → ℝ) (W : List (E × E))
    (K : Submodule ℝ E) (hW : ∀ p∈W,p.1∈K ∧ p.2∈K) (v : E) (hv : v∈K) :
    inverseBroydenModel c θ W v∈K := by
  -- Each actual endpoint update preserves the genuine subspace generated by the real input and stored observed pairs.
  induction W generalizing v with
  | nil => exact K.smul_mem c hv
  | cons p W ih =>
    have hs : p.1∈K := (hW p List.mem_cons_self).1
    have hy : p.2∈K := (hW p List.mem_cons_self).2
    have htail : ∀ q∈W,q.1∈K ∧ q.2∈K := fun q hq => hW q (List.mem_cons_of_mem p hq)
    have hHv := ih htail v hv
    have hHy := ih htail p.2 hy
    change (inverseBroydenUpdate _ p.1 p.2 (θ W.length)) v∈K
    rw [inverseBroydenUpdate,LinearMap.add_apply,LinearMap.smul_apply,LinearMap.smul_apply]
    apply K.add_mem
    · apply K.smul_mem
      rw [inverseDFPUpdate_apply]
      exact K.add_mem (K.sub_mem hHv (K.smul_mem _ hHy)) (K.smul_mem _ hs)
    · apply K.smul_mem
      rw [inverseBFGSUpdate_apply]
      exact K.add_mem (ih htail _ (K.sub_mem hv (K.smul_mem _ hy))) (K.smul_mem _ hs)

/-- The actual full-memory convex Broyden executor satisfies the genuine source information restriction on every real input history.
Use: The actual full-memory convex Broyden executor satisfies the genuine source information restriction on every real input history.
Article: main_krylov, def:classes, actual full-memory convex Broyden executor.
Proof: Every actual pair vector and current gradient is genuinely observed, and the real correction tree is empty. -/
theorem broydenMethod_spanRestricted (c : ℝ) (θ : ℕ → ℝ) :
    ProbedSpanRestricted fullMemory (broydenMethod c θ : ProbedMethod E) := by
  intro H
  refine ⟨?_,fun _ => trivial⟩
  change -inverseBroydenModel c θ H.pairs H.gradient∈H.observedSpan
  apply Submodule.neg_mem
  apply inverseBroydenModel_apply_mem c θ H.pairs H.observedSpan _ H.gradient H.gradient_mem_observedSpan
  intro p hp
  exact ⟨Submodule.subset_span (Or.inl (Or.inl (Or.inr ⟨p,hp,rfl⟩))),
    Submodule.subset_span (Or.inl (Or.inr ⟨p,hp,rfl⟩))⟩
end
end krylov.Methods
