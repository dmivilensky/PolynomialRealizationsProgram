import krylov.Methods.OneGradient

/-!
Article: main_krylov, def:classes, actual observed-span restrictions.
Use: complement the larger policy class used in information lower bounds
with the exact direction/step and stored-correction-span restrictions.
Source: linear combinations of actual observed gradients and secants; no hidden operator is exposed.
-/

namespace krylov.Methods
noncomputable section
open scoped InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The subspace generated by currently observed gradients, steps and derived secant differences.
Use: concrete policies act only in the span of actual data; pair images are explicitly extracted gradient differences.
Article: main_krylov, def:classes, span of observed vectors. -/
def History.observedSpan (H : History E) : Submodule ℝ E :=
  Submodule.span ℝ ({H.initial,H.gradient} ∪ Prod.fst '' {p | p∈H.pairs} ∪
    Prod.snd '' {p | p∈H.pairs} ∪
    {v | ∃ r∈H.records, v=r.direction ∨ v=r.probe ∨
      ∃ p∈r.corrections, v=p.1 ∨ v=p.2})

/-- The current actual observed gradient belongs to the actual information span.
Use: FC's negative-gradient component uses available data.
Article: main_krylov, def:classes.
Proof: it is one of the stated observed generators. -/
theorem History.gradient_mem_observedSpan (H : History E) : H.gradient∈H.observedSpan := by
  apply Submodule.subset_span
  exact Or.inl (Or.inl (Or.inl (Or.inr rfl)))

/-- Every retained actual stored step belongs to the observed information span.
Use: verify concrete direction and evaluated-step restrictions independently of the unknown operators.
Article: main_krylov, def:classes, observed stored steps.
Proof: the selected list is a prefix of the actual extracted pair transcript. -/
theorem windowSteps_mem_observedSpan (memory : ℕ → ℕ) (H : History E)
    (i : Fin (selectedWindow memory H).length) : windowSteps (selectedWindow memory H) i∈H.observedSpan := by
  apply Submodule.subset_span
  apply Or.inl
  apply Or.inl
  apply Or.inr
  exact ⟨(selectedWindow memory H).get i, List.mem_of_mem_take (List.get_mem _ i), rfl⟩

/-- Every retained actual secant difference belongs to the observed information span.
Use: virtual gradients use only derived observed data.
Article: main_krylov, def:classes and alg:xrfc.
Proof: the selected actual pair is a member of the actual history's extracted gradient differences. -/
theorem windowImages_mem_observedSpan (memory : ℕ → ℕ) (H : History E)
    (i : Fin (selectedWindow memory H).length) : windowImages (selectedWindow memory H) i∈H.observedSpan := by
  apply Submodule.subset_span
  apply Or.inl
  apply Or.inr
  exact ⟨(selectedWindow memory H).get i, List.mem_of_mem_take (List.get_mem _ i), rfl⟩

/-- Any actual window combination belongs to a subspace containing its actual vectors.
Use: transfer coefficient-level policies to the physical observed-span restriction.
Article: main_krylov, def:classes.
Proof: each scalar summand belongs to that subspace. -/
theorem combine_mem {ι : Type*} [Fintype ι] (K : Submodule ℝ E) (s : ι → E)
    (hs : ∀ i, s i∈K) (c : ι → ℝ) : combine s c∈K :=
  Submodule.sum_mem K (fun i _ => K.smul_mem _ (hs i))

/-- The computed FC direction respects the exact actual observed-span information restriction.
Use: full and windowed FC/RFC are actual admissible direction policies, beyond merely being nonanticipating.
Article: main_krylov, def:classes(M).
Proof: its negative actual gradient and its computed stored-step combination are both available data. -/
theorem retained_direction_mem_observedSpan (memory : ℕ → ℕ) (H : History E) :
    windowDirection (selectedWindow memory H) H.gradient∈H.observedSpan :=
  H.observedSpan.add_mem (H.observedSpan.neg_mem H.gradient_mem_observedSpan)
    (combine_mem _ _ (windowSteps_mem_observedSpan memory H) _)

/-- A correction decision tree queries only a prescribed actual stored subspace.
Use: enforces the correction-span restriction for every possible future observation, not only a realized branch.
Article: main_krylov, def:classes(M), corrections in span[S,d]. -/
def CorrectionTree.InSubspace (K : Submodule ℝ E) : CorrectionTree E → Prop
  | .done => True
  | .query u next => u∈K ∧ ∀ g, InSubspace K (next g)

/-- Every real movement returned by an actually executed subspace-restricted correction tree remains in that same physical subspace.
Use: the actual total RFC correction stays in the genuine augmented observed span after all queries.
Article: main_krylov, def:classes(M) and lem:projected-residual.
Proof: the true first query belongs to the subspace and its true returned
gradient selects a continuation whose actual movement belongs there by induction. -/
theorem runCorrections_movement_mem (K : Submodule ℝ E) (q : CorrectionTree E)
    (B : E →L[ℝ] E) (g : E) (hq : q.InSubspace K) : (runCorrections q B g).movement∈K := by
  induction q generalizing g with
  | done => exact K.zero_mem
  | query u next ih => exact K.add_mem hq.1 (ih (g+B u) (g+B u) (hq.2 (g+B u)))

/-- Every repeated model correction query remains in the prescribed actual model span.
Use: actual repeated RFC is admissible for arbitrary adaptive new gradients.
Article: main_krylov, def:classes(M), all repeated Uw queries.
Proof: each computed query is a combination of the same actual fixed window vectors. -/
theorem repeatedModelTree_inSubspace {ι : Type*} [Fintype ι] [DecidableEq ι]
    (s : ι → E) (M : Matrix ι ι ℝ) (count : ℕ) (g : E) :
    (repeatedModelTree s M count g).InSubspace (Submodule.span ℝ (Set.range s)) := by
  induction count generalizing g with
  | zero => trivial
  | succ count ih => exact ⟨combine_mem_span _ _,ih⟩

/-- The exact stored-correction-span restriction on a probed policy.
Use: the broader raw protocol can still support lower bounds, while concrete algorithms satisfy the source restriction explicitly.
Article: main_krylov, def:classes(M). -/
def ProbedSpanRestricted (memory : ℕ → ℕ) (m : ProbedMethod E) : Prop :=
  ∀ H, m.direction H∈H.observedSpan ∧ ∀ z,
    (m.correction H z).InSubspace
      (Submodule.span ℝ (Set.range (windowSteps ((m.direction H,z)::selectedWindow memory H))))

/-- Concrete FC satisfies the exact actual probed-class span restrictions.
Use: actual full/restarted/sliding FC is a source-admissible data-only policy.
Article: main_krylov, def:classes(M) and alg:fc.
Proof: its direction is in the observed span and its actual correction tree is empty. -/
theorem fcMethod_spanRestricted (memory : ℕ → ℕ) : ProbedSpanRestricted memory (fcMethod memory : ProbedMethod E) :=
  fun H => ⟨retained_direction_mem_observedSpan memory H,fun _ => trivial⟩

/-- Concrete gated RFC_k satisfies the exact actual probed-class span restrictions.
Use: every possible intermediate correction observation preserves the source's fixed augmented correction span.
Article: main_krylov, def:classes(M) and alg:fc.
Proof: its direction is the actual retained solve; the gate either finishes
or executes the proved fixed-window repeated model tree. -/
theorem rfcMethod_spanRestricted (memory : ℕ → ℕ) (count : ℕ) :
    ProbedSpanRestricted memory (rfcMethod memory count : ProbedMethod E) := by
  -- Both gate branches obey the same actual augmented correction-span restriction.
  intro H
  refine ⟨retained_direction_mem_observedSpan memory H,?_⟩
  intro z
  change (rfcCorrection memory count H z).InSubspace _
  unfold rfcCorrection
  dsimp only
  split
  · exact repeatedModelTree_inSubspace _ _ _ _
  · trivial

/-- The exact evaluated-step information restriction for a one-gradient policy.
Use: the final unevaluated output is an arbitrary function of actual data, as in the source.
Article: main_krylov, def:classes(M₁), observed-span evaluated steps. -/
def OneGradientSpanRestricted (m : OneGradientMethod E) : Prop := ∀ H, m.step H∈H.observedSpan

/-- Concrete step-basis XRFC chooses every actual evaluated displacement in the true observed span.
Use: its virtual model extrapolation spends no extra operator observation.
Article: main_krylov, def:classes(M₁) and alg:xrfc.
Proof: both virtual corrections and virtual gradients combine actual observed
steps/images; its final direction and trial displacement remain in the same actual span. -/
theorem xrfcMethod_spanRestricted (memory : ℕ → ℕ) (trial : History E → ℝ) :
    OneGradientSpanRestricted (xrfcMethod memory trial : OneGradientMethod E) := by
  intro H
  have hs := windowSteps_mem_observedSpan memory H
  have hy := windowImages_mem_observedSpan memory H
  have hg : virtualGradient (selectedWindow memory H) H.gradient∈H.observedSpan :=
    H.observedSpan.add_mem H.gradient_mem_observedSpan (combine_mem _ _ hy _)
  have hd : windowDirection (selectedWindow memory H) (virtualGradient _ H.gradient)∈H.observedSpan :=
    H.observedSpan.add_mem (H.observedSpan.neg_mem hg) (combine_mem _ _ hs _)
  exact H.observedSpan.add_mem (combine_mem _ _ hs _) (H.observedSpan.smul_mem _ hd)

end
end krylov.Methods
