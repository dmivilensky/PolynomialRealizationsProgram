import krylov.Reference.Energy
import krylov.Reference.SpectralMeasure
import krylov.Reference.Christoffel

/-!
Article: main_krylov, s2:eq:cg and lem:chris, the CG/Christoffel bridge.
Use: prove the energy minimum from the actual Krylov Galerkin condition,
rather than assuming a minimizing residual polynomial.
Source: the classical variational proof of CG (Meurant06, GolubMeurant10).
-/

namespace krylov.Reference
noncomputable section
open Matrix Polynomial krylov.Secant
open scoped Matrix Matrix.Norms.L2Operator InnerProductSpace BigOperators
variable {n : ℕ}

/-- The actual canonical vector obtained by applying a polynomial to the physical initial gradient.
Use: the residual and all competing normalized polynomials use the same actual spectral model.
Article: main_krylov, s2:eq:cg, p(A)ê₀. -/
def canonicalPolynomial (base : Matrix (Fin n) (Fin n) ℝ)
    (g : EuclideanSpace ℝ (Fin n)) : ℝ[X] →ₗ[ℝ] EuclideanSpace ℝ (Fin n) :=
  (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹).toLinearMap.comp
    (CG.polynomialAction (cgOperator base) g)

/-- The actual residual polynomial gives exactly the computed canonical error.
Use: connects the polynomial minimum to the executed CG trajectory.
Article: main_krylov, lem:chris, actual CG residual polynomial.
Proof: use the proved actual polynomial representation of the actual gradient. -/
theorem canonicalPolynomial_residual (base : Matrix (Fin n) (Fin n) ℝ)
    (g : EuclideanSpace ℝ (Fin n)) (k : ℕ) :
    canonicalPolynomial base g (CG.residualPolynomial (cgOperator base) g k)=cgCanonicalError base g k := by
  change Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹
    (CG.polynomialAction (cgOperator base) g (CG.residualPolynomial (cgOperator base) g k))=_
  rw [(CG.polynomialAction_pair (cgOperator base) g k).1]
  rfl

/-- Multiplication by the spectral variable converts a dual polynomial action into its primal root action.
Use: normalized polynomial differences are actual Krylov displacements.
Article: main_krylov, lem:chris, p=1+tq.
Proof: evaluate the polynomial product at the true operator and apply the proved inverse-root action identity. -/
theorem canonicalPolynomial_X_mul (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (q : ℝ[X]) :
    canonicalPolynomial base g (X*q)=
      Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)
        (CG.polynomialAction (cgOperator base) g q) := by
  change Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹
    (aeval (cgOperator base) (X*q) g)=_
  rw [map_mul, aeval_X, mul_apply_eq_comp, canonical_reference_action base hb]
  rfl

/-- Equal normalized degree-k polynomials differ by X times a polynomial of degree below k.
Use: the entire admissible class is tested by the actual CG Galerkin condition.
Article: main_krylov, lem:chris, normalized polynomial competitors.
Proof: their zero constant difference is divisible by X; the exact product degree gives the lower bound on degree. -/
theorem normalized_difference {p r : ℝ[X]} {k : ℕ} (hp : p.natDegree≤k)
    (hr : r.natDegree≤k) (h0 : p.eval 0=r.eval 0) :
    ∃ q : ℝ[X], p-r=X*q ∧ q∈degreeLT ℝ k := by
  -- Zero differences and degree zero are handled by the bottom degree, without an artificial positive-degree premise.
  have hd : X∣p-r := X_dvd_iff.mpr (by rw [coeff_zero_eq_eval_zero, eval_sub, h0, sub_self])
  obtain ⟨q, hq⟩ := hd
  refine ⟨q, hq, ?_⟩
  rw [mem_degreeLT]
  by_cases hzero : q=0
  · simp [hzero]
  · have hdeg : (X*q).natDegree≤k := hq ▸ (natDegree_sub_le p r).trans (max_le hp hr)
    rw [natDegree_mul X_ne_zero hzero, natDegree_X] at hdeg
    exact (natDegree_lt_iff_degree_lt hzero).mp (by omega)

/-- Every normalized admissible polynomial has the actual CG energy plus an orthogonal squared excess.
Use: proves the genuine CG energy minimum, including the terminal degree.
Article: main_krylov, lem:chris and s2:eq:cg, energy minimization.
Proof: divide the normalized difference by X; it is a true preceding Krylov
displacement and is orthogonal to the current error by the computed Galerkin condition. -/
theorem cg_energy_excess (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) {k : ℕ} (hk : k≤referenceAtomCount base hb g)
    {p : ℝ[X]} (hp : p.natDegree≤k) (h0 : p.eval 0=1) :
    ‖canonicalPolynomial base g p‖^2=‖cgCanonicalError base g k‖^2+
      ‖canonicalPolynomial base g (p-CG.residualPolynomial (cgOperator base) g k)‖^2 := by
  -- Every competitor is compared with the polynomial generated by the actual finite run.
  obtain ⟨q, hq, hd⟩ := normalized_difference hp (CG.polynomial_degree (cgOperator base) g k).1
    (h0.trans (CG.residualPolynomial_zero (cgOperator base) g k).symm)
  have hm : CG.polynomialAction (cgOperator base) g q∈CG.krylovSpace (cgOperator base) g k :=
    ⟨q, hd, rfl⟩
  have ho := CG.gradient_orthogonal_krylov (cgOperator base) (cgOperator_positive base hb).1
    (cgOperator_positive base hb).2 g k (fun i hi => cg_nonstagnation base hb g i (hi.trans_le hk)) hm
  rw [canonical_search_pairing base hb] at ho
  have ho' : inner ℝ (cgCanonicalError base g k)
      (canonicalPolynomial base g (p-CG.residualPolynomial (cgOperator base) g k))=0 := by
    rw [hq, canonicalPolynomial_X_mul base hb, real_inner_comm]
    exact ho
  have he : canonicalPolynomial base g p=cgCanonicalError base g k+
      canonicalPolynomial base g (p-CG.residualPolynomial (cgOperator base) g k) := by
    rw [map_sub, canonicalPolynomial_residual]
    abel
  calc
    _ = ‖cgCanonicalError base g k+canonicalPolynomial base g
        (p-CG.residualPolynomial (cgOperator base) g k)‖^2 := congrArg (fun v => ‖v‖^2) he
    _ = _ := by rw [norm_add_sq_real, ho']; ring

/-- The actual canonical error is the energy minimum over all normalized degree-k polynomials.
Use: no minimizing-polynomial assumption enters the reference dictionary.
Article: main_krylov, s2:eq:cg and lem:chris.
Proof: the proved excess is a nonnegative squared norm. -/
theorem cg_energy_minimum (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) {k : ℕ} (hk : k≤referenceAtomCount base hb g)
    {p : ℝ[X]} (hp : p.natDegree≤k) (h0 : p.eval 0=1) :
    ‖cgCanonicalError base g k‖^2≤‖canonicalPolynomial base g p‖^2 := by
  rw [cg_energy_excess base hb g hk hp h0]
  exact le_add_of_nonneg_right (sq_nonneg _)

/-- Polynomial operator evaluation scales a genuine eigenvector pairing by its scalar polynomial value.
Use: all competing polynomials, rather than only computed residuals, share the true spectral representation.
Article: main_krylov, lem:chris, polynomial spectral integration.
Proof: polynomial induction moves the symmetric operator across the pairing at each multiplication by X. -/
theorem CG.polynomialAction_eigenvector {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (Q : E →L[ℝ] E) (hQ : Q.toLinearMap.IsSymmetric) (g v : E) (t : ℝ)
    (hv : Q v=t • v) (p : ℝ[X]) :
    inner ℝ v (CG.polynomialAction Q g p)=p.eval t*inner ℝ v g := by
  -- The induction uses the actual operator algebra and its actual symmetric eigenvector action.
  induction p using Polynomial.induction_on with
  | C a => simp [CG.polynomialAction, real_inner_smul_right]
  | add p q ihp ihq =>
    rw [map_add, inner_add_right, ihp, ihq, eval_add, add_mul]
  | monomial k a ih =>
    have he : C a*X^(k+1)=X*(C a*X^k) := by ring
    have hs := hQ v (CG.polynomialAction Q g (C a*X^k))
    change inner ℝ (Q v) (CG.polynomialAction Q g (C a*X^k))=
      inner ℝ v (Q (CG.polynomialAction Q g (C a*X^k))) at hs
    rw [hv, real_inner_smul_left] at hs
    rw [he]
    change inner ℝ v (aeval Q (X*(C a*X^k)) g)=_
    rw [map_mul, aeval_X, mul_apply_eq_comp]
    change inner ℝ v (Q (CG.polynomialAction Q g (C a*X^k)))=_
    rw [← hs, ih]
    simp only [eval_mul, eval_X]
    ring

/-- The genuine canonical polynomial vector has its actual scalar polynomial eigen-coordinates.
Use: transfers the computed CG variational minimum into the true energy spectral measure.
Article: main_krylov, s2:eq:cg, p(A)ê₀.
Proof: use the physical polynomial pairing formula and cancel the positive root eigenvalue on both sides. -/
theorem canonicalPolynomial_coordinate (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (p : ℝ[X]) (i : Fin n) :
    inner ℝ (hb.1.eigenvectorBasis i) (canonicalPolynomial base g p)=
      p.eval (hb.1.eigenvalues i)*inner ℝ (hb.1.eigenvectorBasis i) (cgCanonicalError base g 0) := by
  -- Positivity justifies cancellation in the real physical/canonical coordinate transformation.
  have hact : cgOperator base (hb.1.eigenvectorBasis i)=hb.1.eigenvalues i • hb.1.eigenvectorBasis i := by
    ext j
    exact congrFun (hb.1.mulVec_eigenvectorBasis i) j
  have he := CG.polynomialAction_eigenvector (cgOperator base) (cgOperator_positive base hb).1
    g (hb.1.eigenvectorBasis i) (hb.1.eigenvalues i) hact p
  rw [gradient_spectral_coordinate base hb (CG.polynomialAction (cgOperator base) g p) i,
    gradient_spectral_coordinate base hb g i] at he
  apply mul_left_cancel₀ (Real.sqrt_pos.mpr (hb.eigenvalues_pos i)).ne'
  change Real.sqrt (hb.1.eigenvalues i)*inner ℝ (hb.1.eigenvectorBasis i)
    (canonicalPolynomial base g p)=Real.sqrt (hb.1.eigenvalues i)*
      (p.eval (hb.1.eigenvalues i)*inner ℝ (hb.1.eigenvectorBasis i) (cgCanonicalError base g 0))
  change Real.sqrt (hb.1.eigenvalues i)*inner ℝ (hb.1.eigenvectorBasis i)
    (canonicalPolynomial base g p)=p.eval (hb.1.eigenvalues i)*
      (Real.sqrt (hb.1.eigenvalues i)*inner ℝ (hb.1.eigenvectorBasis i) (cgCanonicalError base g 0)) at he
  exact he.trans (by ring)

/-- A nonzero initial physical gradient gives a nonzero actual canonical initial error.
Use: normalize the energy spectral probability only when its energy is positive.
Article: main_krylov, s2:eq:cg, normalization of ν.
Proof: the genuine root/inverse pairing would otherwise make the squared physical gradient norm zero. -/
theorem cgCanonicalError_initial_ne_zero (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) : cgCanonicalError base g 0≠0 := by
  intro hz
  have he := canonical_search_pairing base hb g g
  change inner ℝ g g=inner ℝ _ (cgCanonicalError base g 0) at he
  rw [hz, inner_zero_right] at he
  exact hg (inner_self_eq_zero.mp he)

/-- The true energy spectral probability data for every nonzero reference, with arbitrary active atom count.
Use: all Christoffel and Jacobi constructions are applied to this computed measure.
Article: main_krylov, s2:eq:cg, ν. -/
def energySpectralData (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) : jacobi.Finite.DiscreteMeasure (referenceAtomCount base hb g) :=
  vectorSpectralData base hb.1 (cgCanonicalError base g 0) (cgCanonicalError_initial_ne_zero base hb g hg)

/-- Polynomial energy is exactly the initial energy times its actual spectral L² norm.
Use: identifies the variational class and normalization in the CG/Christoffel dictionary.
Article: main_krylov, lem:chris, spectral energy identity.
Proof: apply actual eigenbasis Parseval, the proved polynomial coordinate formula,
and the actual aggregated spectral integration theorem. -/
theorem canonicalPolynomial_energy (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) (p : ℝ[X]) :
    ‖canonicalPolynomial base g p‖^2=‖cgCanonicalError base g 0‖^2*
      ‖(energySpectralData base hb g hg).evaluate p‖^2 := by
  -- Both sides are expanded in the same genuine eigenbasis, with repeated values aggregated only afterward.
  have hp : ‖canonicalPolynomial base g p‖^2=
      ∑ i : Fin n, (inner ℝ (hb.1.eigenvectorBasis i) (cgCanonicalError base g 0))^2*
        (p.eval (hb.1.eigenvalues i))^2 := by
    have he := EuclideanSpace.real_norm_sq_eq (hb.1.eigenvectorBasis.repr (canonicalPolynomial base g p))
    rw [hb.1.eigenvectorBasis.repr.norm_map] at he
    rw [he]
    apply Finset.sum_congr rfl
    intro i _
    rw [OrthonormalBasis.repr_apply_apply, canonicalPolynomial_coordinate base hb]
    ring
  have hn := (sq_pos_of_pos (norm_pos_iff.mpr (cgCanonicalError_initial_ne_zero base hb g hg))).ne'
  rw [← real_inner_self_eq_norm_sq ((energySpectralData base hb g hg).evaluate p),
    jacobi.Finite.DiscreteMeasure.inner_evaluate]
  have hs : (∑ i, (energySpectralData base hb g hg).weight i*
      p.eval ((energySpectralData base hb g hg).node i)*p.eval ((energySpectralData base hb g hg).node i))=
      (∑ i : Fin n, (inner ℝ (hb.1.eigenvectorBasis i) (cgCanonicalError base g 0))^2*
        (p.eval (hb.1.eigenvalues i))^2)/‖cgCanonicalError base g 0‖^2 := by
    have he := vectorSpectralData_integral base hb.1 (cgCanonicalError base g 0)
      (cgCanonicalError_initial_ne_zero base hb g hg) (fun t => (p.eval t)^2)
    change (∑ i, (energySpectralData base hb g hg).weight i*
      (p.eval ((energySpectralData base hb g hg).node i))^2)=_ at he
    convert he using 1
    apply Finset.sum_congr rfl
    intro i _
    ring
  rw [hs, hp, mul_div_cancel₀ _ hn]

/-- The true CG residual is the uniquely constructed exterior Christoffel polynomial before exhaustion.
Use: every later Christoffel coefficient comes from the computed algorithm and its actual energy measure.
Article: main_krylov, s2:eq:cg and lem:chris, CG/Christoffel polynomial dictionary.
Proof: compare the actual CG energy minimum with the attained reproducing-kernel
minimum, cancel the positive initial energy, and apply the proved unique equality case. -/
theorem residualPolynomial_eq_christoffel (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) {k : ℕ} (hk : k<referenceAtomCount base hb g) :
    CG.residualPolynomial (cgOperator base) g k=christoffelPolynomial (energySpectralData base hb g hg) k 0 := by
  -- The two independent minimum constructions coincide because both use the actual normalized spectral energy.
  let M := energySpectralData base hb g hg
  have ha := christoffelPolynomial_admissible M k 0
  have hc := cg_energy_minimum base hb g hk.le ha.1 ha.2
  rw [← canonicalPolynomial_residual base g k, canonicalPolynomial_energy base hb g hg,
    canonicalPolynomial_energy base hb g hg, christoffelPolynomial_norm M hk 0] at hc
  have hn : 0<‖cgCanonicalError base g 0‖^2 :=
    sq_pos_of_pos (norm_pos_iff.mpr (cgCanonicalError_initial_ne_zero base hb g hg))
  have hle := (mul_le_mul_iff_right₀ hn).mp hc
  have hm := christoffel_minimum_unique M hk 0 (CG.polynomial_degree (cgOperator base) g k).1
    (CG.residualPolynomial_zero (cgOperator base) g k)
  exact hm.2.mp (le_antisymm hle hm.1)

/-- The computed CG squared error is initial energy times the reciprocal actual Christoffel kernel.
Use: supplies the exact coefficient used throughout the article's variation and design theory.
Article: main_krylov, lem:chris, ‖e_k‖_A²=‖e₀‖_A² λ_k(0;ν).
Proof: insert the identified actual minimizing residual polynomial into the proved spectral energy identity. -/
theorem cg_energy_christoffel (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) {k : ℕ} (hk : k<referenceAtomCount base hb g) :
    ‖cgCanonicalError base g k‖^2=‖cgCanonicalError base g 0‖^2*
      (christoffelKernel (energySpectralData base hb g hg) k 0)⁻¹ := by
  rw [← canonicalPolynomial_residual base g k, canonicalPolynomial_energy base hb g hg,
    residualPolynomial_eq_christoffel base hb g hg hk, christoffelPolynomial_norm _ hk 0]

end
end krylov.Reference
