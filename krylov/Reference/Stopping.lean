import krylov.Reference.ActiveSpectrum
import Mathlib.LinearAlgebra.Dimension.Finite

/-!
Article: main_krylov, s2:eq:cg and prop:dict(iii), exact reference stopping.
Use: handle every active atom count, including repeated eigenvalues, absent
spectral coordinates and an initially zero gradient.
Source: the classical finite spectral CG argument (Meurant06), using the
already proved actual residual polynomials and residual orthogonality.
-/

namespace krylov.Reference
noncomputable section
open Matrix krylov.Secant Polynomial
open scoped Matrix Matrix.Norms.L2Operator InnerProductSpace BigOperators
variable {n : ℕ}

/-- Once the computed gradient is zero, the next computed gradient is zero as well.
Use: totalized CG agrees with stopping at its first solved iterate.
Article: main_krylov, prop:dict(iii), finite termination.
Proof: the exact-search numerator and the resulting displacement vanish. -/
theorem CG.gradient_succ_of_zero {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (Q : E →L[ℝ] E) (g : E) (k : ℕ) (hk : CG.gradient Q g k=0) :
    CG.gradient Q g (k+1)=0 := by
  rw [CG.gradient_succ]
  change CG.gradient Q g k + (-inner ℝ (CG.direction Q g k) (CG.gradient Q g k) / _) • _ = 0
  simp only [hk, inner_zero_right, neg_zero, zero_div, zero_smul, add_zero]

/-- All subsequent computed gradients remain zero after the first solution.
Use: transfers exact finite stopping to any longer requested horizon.
Article: main_krylov, prop:dict(iii), static quadratic termination.
Proof: induction on the later iteration applies the zero-preserving update. -/
theorem CG.gradient_eq_zero_of_le {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (Q : E →L[ℝ] E) (g : E) {k j : ℕ} (hk : CG.gradient Q g k=0) (hkj : k≤j) :
    CG.gradient Q g j=0 := by
  induction j, hkj using Nat.le_induction with
  | base => exact hk
  | succ j _ ih => exact CG.gradient_succ_of_zero Q g j ih

/-- Every active energy atom has an actual active physical eigenvector representative.
Use: repeated eigenvalues are counted once in the general nonstagnation theorem.
Article: main_krylov, s2:eq:cg, active support of ν.
Proof: unpack membership of the finite spectral image and use the positive-root coordinate identity. -/
theorem active_atom_representative (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) {t : ℝ}
    (ht : t∈activeSpectralValues base hb.1
      (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g)) :
    ∃ i : Fin n, hb.1.eigenvalues i=t ∧ inner ℝ (hb.1.eigenvectorBasis i) g≠0 := by
  obtain ⟨i, hi, he⟩ := Finset.mem_image.mp ht
  refine ⟨i, he, ?_⟩
  rw [gradient_spectral_coordinate base hb]
  exact mul_ne_zero (Real.sqrt_pos.mpr (hb.eigenvalues_pos i)).ne'
    (Finset.mem_filter.mp hi).2

/-- The actual CG residual cannot vanish before the number of distinct active atoms.
Use: supplies finite-prefix nondegeneracy for arbitrary spectra and initial gradients.
Article: main_krylov, s2:eq:cg and prop:dict(iii).
Proof: choose one genuine eigenvector for each distinct active energy atom,
then apply the already proved residual-polynomial root obstruction. -/
theorem cg_nonstagnation (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) :
    ∀ k<referenceAtomCount base hb g, CG.gradient (cgOperator base) g k≠0 := by
  -- Enumerate actual distinct atoms, rather than the ambient eigenbasis with multiplicities.
  let S := activeSpectralValues base hb.1
    (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g)
  let e := S.equivFin.symm
  have hr (j : Fin S.card) := active_atom_representative base hb g (e j).property
  choose idx he ha using hr
  have hd : Function.Injective (fun j : Fin S.card => (e j).val) :=
    Subtype.val_injective.comp e.injective
  have haction (j : Fin S.card) : cgOperator base (hb.1.eigenvectorBasis (idx j))=
      (e j).val • hb.1.eigenvectorBasis (idx j) := by
    rw [← he j]
    ext i
    exact congrFun (hb.1.mulVec_eigenvectorBasis (idx j)) i
  exact CG.nonstagnation_of_active_eigenvectors (cgOperator base)
    (cgOperator_positive base hb).1 g (fun j => hb.1.eigenvectorBasis (idx j))
    (fun j => (e j).val) hd haction ha

/-- The component of the initial gradient in one actual eigenspace.
Use: the cyclic spectral space has one generator per active value, even with multiplicity.
Article: main_krylov, s2:eq:cg, cyclic spectral support. -/
def cyclicSpectralVector (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.IsHermitian)
    (g : EuclideanSpace ℝ (Fin n)) (t : ℝ) : EuclideanSpace ℝ (Fin n) :=
  hb.eigenvectorBasis.repr.symm (WithLp.toLp 2
    (fun i => if hb.eigenvalues i=t then inner ℝ (hb.eigenvectorBasis i) g else 0))

/-- Every computed CG gradient belongs to the space generated by the actual active eigenspace components.
Use: finite termination depends on the active atom count rather than the physical dimension.
Article: main_krylov, prop:dict(iii), cyclic spectral dimension bound.
Proof: in the true eigenbasis the computed residual polynomial scales each
initial eigenspace component by its value at that single active eigenvalue. -/
theorem gradient_mem_cyclic_span (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (k : ℕ) :
    CG.gradient (cgOperator base) g k ∈ Submodule.span ℝ
      (cyclicSpectralVector base hb.1 g ''
        (activeSpectralValues base hb.1
          (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g) : Set ℝ)) := by
  let S := activeSpectralValues base hb.1
    (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g)
  have he : CG.gradient (cgOperator base) g k =
      ∑ t∈S, (CG.residualPolynomial (cgOperator base) g k).eval t • cyclicSpectralVector base hb.1 g t := by
    -- Equality is checked in the actual orthonormal eigenbasis, including all zero-weight coordinates.
    apply hb.1.eigenvectorBasis.repr.injective
    ext i
    have haction : cgOperator base (hb.1.eigenvectorBasis i)=
        hb.1.eigenvalues i • hb.1.eigenvectorBasis i := by
      ext j
      exact congrFun (hb.1.mulVec_eigenvectorBasis i) j
    have hp := (CG.eigenvector_polynomial_pairings (cgOperator base)
      (cgOperator_positive base hb).1 g (hb.1.eigenvectorBasis i) (hb.1.eigenvalues i) haction k).1
    simp only [map_sum, map_smul, WithLp.ofLp_sum, Finset.sum_apply,
      PiLp.smul_apply, OrthonormalBasis.repr_apply_apply, cyclicSpectralVector,
      LinearIsometryEquiv.apply_symm_apply]
    rw [hp]
    by_cases hi : hb.1.eigenvalues i∈S
    · rw [Finset.sum_eq_single (hb.1.eigenvalues i)]
      · simp
      · intro t _ ht
        simp [Ne.symm ht]
      · exact fun hn => (hn hi).elim
    · have hz : inner ℝ (hb.1.eigenvectorBasis i) g=0 := by
        rw [gradient_spectral_coordinate base hb]
        have hc : inner ℝ (hb.1.eigenvectorBasis i)
            (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g)=0 := by
          by_contra h
          exact hi (Finset.mem_image.mpr ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, h⟩, rfl⟩)
        rw [hc, mul_zero]
      simp only [hz, mul_zero, ite_self, smul_zero, Finset.sum_const_zero]
  rw [he]
  exact Submodule.sum_mem _ (fun t ht => Submodule.smul_mem _ _
    (Submodule.subset_span ⟨t, ht, rfl⟩))

/-- Actual CG stops exactly at its number of active atoms.
Use: validates every later terminal construction for arbitrary reference spectra.
Article: main_krylov, prop:dict(iii), exact finite termination.
Proof: otherwise all preceding residuals and the current residual would be
nonzero and mutually orthogonal inside a space generated by only N active
eigenspace components, contradicting finite-dimensional independence. -/
theorem cg_terminates (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) :
    CG.gradient (cgOperator base) g (referenceAtomCount base hb g)=0 := by
  -- The contradiction is finite: N+1 computed orthogonal residuals in an at-most-N-dimensional cyclic space.
  let N := referenceAtomCount base hb g
  let S := activeSpectralValues base hb.1
    (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (metricRoot base)⁻¹ g)
  let K := Submodule.span ℝ (cyclicSpectralVector base hb.1 g '' (S : Set ℝ))
  by_contra hn
  have hne (i : Fin (N+1)) : CG.gradient (cgOperator base) g i.val≠0 := by
    intro hz
    exact hn (CG.gradient_eq_zero_of_le _ _ hz (by omega))
  let v : Fin (N+1) → K := fun i => ⟨_, gradient_mem_cyclic_span base hb g i.val⟩
  have hli : LinearIndependent ℝ v := by
    apply linearIndependent_of_ne_zero_of_inner_eq_zero
    · intro i hi
      exact hne i (congrArg Subtype.val hi)
    · intro i j hij
      change inner ℝ (CG.gradient (cgOperator base) g i.val) (CG.gradient (cgOperator base) g j.val)=0
      have horth (a b : Fin (N+1)) (hab : a.val<b.val) :
          inner ℝ (CG.gradient (cgOperator base) g a.val) (CG.gradient (cgOperator base) g b.val)=0 :=
        (CG.invariant (cgOperator base) (cgOperator_positive base hb).1
          (cgOperator_positive base hb).2 g b.val
          (fun k hk => hne ⟨k, by omega⟩)).old_gradient a.val hab
      rcases lt_or_gt_of_ne (show i.val≠j.val from fun h => hij (Fin.ext h)) with h | h
      · exact horth i j h
      · rw [real_inner_comm]
        exact horth j i h
  have hbound : Module.finrank ℝ K≤N := by
    have h := finrank_span_finset_le_card (R := ℝ) (S.image (cyclicSpectralVector base hb.1 g))
    have himg : (↑(S.image (cyclicSpectralVector base hb.1 g)) : Set (EuclideanSpace ℝ (Fin n)))=
        cyclicSpectralVector base hb.1 g '' (S : Set ℝ) := by simp
    change Module.finrank ℝ (Submodule.span ℝ (↑(S.image (cyclicSpectralVector base hb.1 g)) : Set (EuclideanSpace ℝ (Fin n)))) ≤ _ at h
    rw [himg] at h
    exact h.trans (Finset.card_image_le.trans (le_refl S.card))
  have hcard := hli.fintype_card_le_finrank
  simp only [Fintype.card_fin] at hcard
  omega

/-- Actual CG has solved the quadratic precisely when the iteration reaches its active atom count.
Use: a complete stopping rule, including an initially solved reference and the entire solved tail.
Article: main_krylov, prop:dict(iii), exact active-spectrum termination.
Proof: early zero contradicts the proved active-atom obstruction; later zero follows from exact stopping and zero preservation. -/
theorem cg_stopping_iff (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (k : ℕ) :
    CG.gradient (cgOperator base) g k=0 ↔ referenceAtomCount base hb g≤k := by
  constructor
  · intro hz
    by_contra hk
    exact cg_nonstagnation base hb g k (by omega) hz
  · exact CG.gradient_eq_zero_of_le _ _ (cg_terminates base hb g)

/-- All canonical steps before actual active-spectrum exhaustion form the actual orthonormal reference frame.
Use: later prefixes require no assumption that the atom count equals the ambient dimension.
Article: main_krylov, s2:eq:cg, the canonical orthonormal steps.
Proof: apply the existing computed-step orthogonality theorem to the proved general nonstagnating prefix. -/
theorem canonicalCG_frame (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) :
    Orthonormal ℝ (fun i : Fin (referenceAtomCount base hb g) => canonicalCGUnitStep base g i.val) :=
  canonicalCGUnitStep_orthonormal base hb g _ (cg_nonstagnation base hb g)

end
end krylov.Reference
