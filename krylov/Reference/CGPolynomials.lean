import krylov.Reference.CGGeometry
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Polynomial.Degree.Lemmas

/-!
Article: main_krylov, s2:eq:cg and lem:terminal-fibre, actual CG nonstagnation.
Use: the actual residual polynomial has degree at most the number of executed
steps and value one at zero; too many active eigenvalues therefore prohibit early termination.
Source: classical CG residual polynomials and mathlib's proved finite polynomial root bound.
-/

namespace krylov.Reference.CG
noncomputable section
open Polynomial
open scoped InnerProductSpace
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Residual and direction polynomials generated by the actual executed CG coefficients.
Use: no frozen, idealized or chosen terminal polynomial replaces the true reference run.
Article: main_krylov, s2:eq:cg, actual CG residual polynomials. -/
def polynomialRun (Q : E →L[ℝ] E) (g : E) : ℕ → ℝ[X] × ℝ[X]
  | 0 => (1,-1)
  | k+1 =>
      let p := polynomialRun Q g k
      let r := p.1+C (length Q g k)*X*p.2
      (r,-r+C (beta Q g k)*p.2)

/-- The actual residual polynomial of the concrete CG run.
Use: nonstagnation follows from its true values at actual active eigenvalues.
Article: main_krylov, s2:eq:cg, p_k. -/
def residualPolynomial (Q : E →L[ℝ] E) (g : E) (k : ℕ) : ℝ[X] := (polynomialRun Q g k).1

/-- The actual direction polynomial of the concrete CG run.
Use: its degree controls the next actual residual polynomial.
Article: main_krylov, s2:eq:cg, direction polynomial. -/
def directionPolynomial (Q : E →L[ℝ] E) (g : E) (k : ℕ) : ℝ[X] := (polynomialRun Q g k).2

/-- The true residual polynomial obeys the true executed gradient-update recurrence.
Use: its constant coefficient and degree follow from its actual construction.
Article: main_krylov, s2:eq:cg.
Proof: unfold one actual polynomial state update. -/
theorem residualPolynomial_succ (Q : E →L[ℝ] E) (g : E) (k : ℕ) :
    residualPolynomial Q g (k+1)=residualPolynomial Q g k+C (length Q g k)*X*directionPolynomial Q g k := rfl

/-- The true direction polynomial obeys the true executed direction-update recurrence.
Use: bound the actual next direction degree and actual spectral coordinates.
Article: main_krylov, s2:eq:cg.
Proof: unfold one actual polynomial state update. -/
theorem directionPolynomial_succ (Q : E →L[ℝ] E) (g : E) (k : ℕ) :
    directionPolynomial Q g (k+1)= -residualPolynomial Q g (k+1)+C (beta Q g k)*directionPolynomial Q g k := rfl

/-- Every actual residual polynomial has the exact required normalization at zero.
Use: its actual finite root set cannot come from the zero polynomial.
Article: main_krylov, s2:eq:cg, p_k(0)=1.
Proof: each actual residual update adds a multiple of X. -/
theorem residualPolynomial_zero (Q : E →L[ℝ] E) (g : E) (k : ℕ) :
    (residualPolynomial Q g k).eval 0=1 := by
  induction k with
  | zero => simp only [residualPolynomial, polynomialRun, eval_one]
  | succ k ih =>
    rw [residualPolynomial_succ]
    simpa only [eval_add, eval_mul, eval_C, eval_X, mul_zero, zero_mul, add_zero] using ih

/-- Both actual polynomial degrees are bounded by the actual number of performed CG searches.
Use: the true residual cannot annihilate more active eigenvalues than its executed prefix length.
Article: main_krylov, s2:eq:cg, deg p_k≤k.
Proof: the actual residual update increases degree by at most one and the
actual direction recurrence preserves that bound, even when coefficients vanish. -/
theorem polynomial_degree (Q : E →L[ℝ] E) (g : E) (k : ℕ) :
    (residualPolynomial Q g k).natDegree≤k ∧ (directionPolynomial Q g k).natDegree≤k := by
  -- Bound every true polynomial product before combining the two executed recurrences.
  induction k with
  | zero => simp [residualPolynomial, directionPolynomial, polynomialRun]
  | succ k ih =>
    have hx : (C (length Q g k)*X : ℝ[X]).natDegree≤1 :=
      (natDegree_C_mul_le _ _).trans (by simp only [natDegree_X, le_refl])
    have hm := (natDegree_mul_le (p := C (length Q g k)*X) (q := directionPolynomial Q g k)).trans
      (Nat.add_le_add hx ih.2)
    have hr : (residualPolynomial Q g (k+1)).natDegree≤k+1 := by
      rw [residualPolynomial_succ]
      exact natDegree_add_le_of_degree_le (ih.1.trans (Nat.le_succ k)) (by omega)
    refine ⟨hr, ?_⟩
    rw [directionPolynomial_succ]
    apply (natDegree_add_le _ _).trans
    rw [natDegree_neg]
    exact max_le hr ((natDegree_C_mul_le _ _).trans (ih.2.trans (Nat.le_succ k)))

/-- Every actual eigenvector pairing follows the actual computed CG polynomial values.
Use: transfers early termination of the true algorithm into actual polynomial roots.
Article: main_krylov, s2:eq:cg, spectral residual representation.
Proof: symmetry moves the true operator onto the actual eigenvector; both
executed recurrences then become exactly the two actual scalar polynomial recurrences. -/
theorem eigenvector_polynomial_pairings (Q : E →L[ℝ] E) (hQ : Q.toLinearMap.IsSymmetric)
    (g v : E) (μ : ℝ) (hv : Q v=μ • v) (k : ℕ) :
    inner ℝ v (gradient Q g k)=(residualPolynomial Q g k).eval μ*inner ℝ v g ∧
    inner ℝ v (direction Q g k)=(directionPolynomial Q g k).eval μ*inner ℝ v g := by
  -- Each true operator pairing reduces to multiplication by the actual eigenvalue.
  induction k with
  | zero => simp [gradient, direction, cgRun, residualPolynomial, directionPolynomial, polynomialRun]
  | succ k ih =>
    have hact : inner ℝ v (Q (direction Q g k))=μ*inner ℝ v (direction Q g k) := by
      have he := hQ v (direction Q g k)
      change inner ℝ (Q v) (direction Q g k)=inner ℝ v (Q (direction Q g k)) at he
      rw [← he, hv, real_inner_smul_left]
    have hr : inner ℝ v (gradient Q g (k+1))=(residualPolynomial Q g (k+1)).eval μ*inner ℝ v g := by
      rw [gradient_succ, inner_add_right, real_inner_smul_right, hact, ih.1, ih.2, residualPolynomial_succ]
      simp only [eval_add, eval_mul, eval_C, eval_X]
      ring
    refine ⟨hr, ?_⟩
    rw [direction_succ, inner_add_right, inner_neg_right, real_inner_smul_right, hr, ih.2,
      directionPolynomial_succ]
    simp only [eval_add, eval_neg, eval_mul, eval_C]
    ring

/-- The actual CG residual is nonzero before the number of distinct actually active eigenvalues.
Use: supplies genuine nonstagnation rather than an assumed orthonormal reference frame.
Article: main_krylov, lem:terminal-fibre and s2:eq:cg, n-atom reference.
Proof: a zero true residual would make its actual normalized degree-k polynomial
vanish at every one of the m distinct active eigenvalues, contradicting the
proved finite root bound when k<m. -/
theorem nonstagnation_of_active_eigenvectors {m : ℕ} (Q : E →L[ℝ] E)
    (hQ : Q.toLinearMap.IsSymmetric) (g : E) (v : Fin m → E) (μ : Fin m → ℝ)
    (hμ : Function.Injective μ) (heig : ∀ i, Q (v i)=μ i • v i)
    (hactive : ∀ i, inner ℝ (v i) g≠0) (k : ℕ) (hk : k<m) : gradient Q g k≠0 := by
  -- Every actual active eigenvalue would be a root of the same true nonzero degree-k polynomial.
  intro hz
  let p := residualPolynomial Q g k
  have hp : p≠0 := by
    intro he
    have hh := residualPolynomial_zero Q g k
    rw [show residualPolynomial Q g k=0 from he, eval_zero] at hh
    exact zero_ne_one hh
  have hroot (i : Fin m) : μ i∈p.roots := by
    apply (mem_roots hp).mpr
    have he := (eigenvector_polynomial_pairings Q hQ g (v i) (μ i) (heig i) k).1
    rw [hz, inner_zero_right] at he
    exact (mul_eq_zero.mp he.symm).resolve_right (hactive i)
  have hcard := card_le_degree_of_subset_roots (p := p) (Z := Finset.univ.image μ)
    (by intro a ha; change a∈Finset.univ.image μ at ha
        obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp ha
        exact hroot i)
  rw [Finset.card_image_of_injective _ hμ, Finset.card_univ, Fintype.card_fin] at hcard
  have hdeg := (polynomial_degree Q g k).1
  change p.natDegree≤k at hdeg
  omega

end
end krylov.Reference.CG
