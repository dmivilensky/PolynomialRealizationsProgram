import krylov.Reference.Energy
import krylov.Reference.Exhaustion
import krylov.LinearAlgebra.PlanarWitness
import krylov.LinearAlgebra.HilbertSchmidtCompression

/-!
Article: main_krylov, thm:A and prop:HS, actual reference response geometry.
Use: construct the old flags and remaining-tail vectors from the actual
finite CG run and derive their orthogonality and common attaining direction.
Source: exact CG Galerkin orthogonality, the proved canonical frame and energy tails.
-/

namespace krylov.Variation
noncomputable section
open Matrix krylov.Reference krylov.LinearAlgebra
open scoped InnerProductSpace BigOperators Matrix.Norms.L2Operator
variable {n : ℕ}

/-- The old canonical flag generated by the actual reference steps through l.
Use: the full-cycle response uses the true reference Galerkin flags.
Article: main_krylov, thm:A, P_l projects onto A^(1/2)K_(l+1). -/
def oldFlag (base : Matrix (Fin n) (Fin n) ℝ) (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) :
    Submodule ℝ (EuclideanSpace ℝ (Fin n)) :=
  Submodule.span ℝ (canonicalCGUnitStep base g '' Set.Iic l)

/-- The actual remaining canonical CG displacement after step l.
Use: the first-variation tail is constructed from the actual reference, including terminal zero tails.
Article: main_krylov, thm:A, v_l=−ê_(l+1). -/
def remainingTail (base : Matrix (Fin n) (Fin n) ℝ) (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) :
    EuclideanSpace ℝ (Fin n) := -cgCanonicalError base g (l+1)

/-- Every actual reference old step belongs to its true old flag.
Use: verifies the common-direction requirement of the sharp attaining families.
Article: main_krylov, thm:A, old flags.
Proof: it is one of the actual generators. -/
theorem unitStep_mem_oldFlag (base : Matrix (Fin n) (Fin n) ℝ) (g : EuclideanSpace ℝ (Fin n))
    {i l : ℕ} (hi : i≤l) : canonicalCGUnitStep base g i∈oldFlag base g l :=
  Submodule.subset_span ⟨i,hi,rfl⟩

/-- The actual remaining tail is orthogonal to the actual old reference flag.
Use: sharp compression estimates have their true CG orthogonality hypothesis discharged.
Article: main_krylov, thm:A and prop:HS.
Proof: the proved actual CG frame pairs each earlier unit step orthogonally
with the actual later canonical residual; the span's orthogonal complement is then characterized on generators. -/
theorem remainingTail_orthogonal (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) (hl : l<referenceAtomCount base hb g) :
    remainingTail base g l∈(oldFlag base g l)ᗮ := by
  -- Orthogonality to the true old generators extends to their entire actual linear span.
  intro u hu
  induction hu using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨i,hi,rfl⟩ := hu
    change i≤l at hi
    have he : inner ℝ (canonicalCGUnitStep base g i) (cgCanonicalError base g (l+1))=0 :=
      canonicalCG_old_step_orth base hb g (referenceAtomCount base hb g)
        (canonicalCG_frame base hb g) ⟨i,by omega⟩ (l+1) (by omega) (by change i<l+1; omega)
    change inner ℝ (canonicalCGUnitStep base g i) (-cgCanonicalError base g (l+1))=0
    rw [inner_neg_right, he, neg_zero]
  | zero => exact inner_zero_left _
  | add x y _ _ hx hy => rw [inner_add_left, hx, hy, add_zero]
  | smul a x _ hx => rw [real_inner_smul_left, hx, mul_zero]

/-- The actual remaining tail is the sum of the genuine remaining canonical steps.
Use: the response contains actual displacement tails, not prescribed energy coefficients.
Article: main_krylov, thm:A, v_l=Σ_(j>l)√c_j q_j.
Proof: the proved actual CG terminal telescoping identity. -/
theorem remainingTail_eq_sum (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) (hl : l<referenceAtomCount base hb g) :
    remainingTail base g l=∑ j∈Finset.Ico (l+1) (referenceAtomCount base hb g), canonicalCGStep base g j :=
  (canonicalCGStep_tail base hb g (by omega)).symm

/-- The remaining response tail has exactly the actual remaining canonical error norm.
Use: converts the sharp operator response constant to the reference error profile.
Article: main_krylov, thm:A, ‖v_l‖=‖e_(l+1)‖_A.
Proof: the norm of the negative actual error equals its norm. -/
theorem remainingTail_norm (base : Matrix (Fin n) (Fin n) ℝ) (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) :
    ‖remainingTail base g l‖=‖cgCanonicalError base g (l+1)‖ := norm_neg _

/-- Every true response-tail norm is the initial actual error norm times its genuine Christoffel-profile root.
Use: the sharp reference response constants have exactly the source's spectral-measure normalization.
Article: main_krylov, thm:A and prop:HS, √λ_(l+1)(0;ν).
Proof: the constructed finite spectral value is nonnegative; take the
nonnegative square roots of the already proved all-degree actual CG energy identity. -/
theorem remainingTail_christoffel (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hg : g≠0) (l : ℕ) :
    ‖remainingTail base g l‖=‖cgCanonicalError base g 0‖*
      Real.sqrt (finiteChristoffelValue (energySpectralData base hb g hg) (l+1)) := by
  -- The finite-support convention includes genuine zero terminal tails.
  have hc : 0≤finiteChristoffelValue (energySpectralData base hb g hg) (l+1) := by
    unfold finiteChristoffelValue
    split
    · exact inv_nonneg.mpr (christoffelKernel_pos _ _ _).le
    · exact le_refl 0
  rw [remainingTail_norm]
  apply (sq_eq_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (Real.sqrt_nonneg _))).mp
  rw [mul_pow, Real.sq_sqrt hc]
  exact cg_energy_christoffel_all base hb g hg (l+1)

/-- Every preterminal response tail is genuinely nonzero.
Use: justifies normalizing the actual attaining direction without imposing a smallest-step lower bound.
Article: main_krylov, thm:A, the planar sharpness witness.
Proof: an inverse-root zero would force the actual CG gradient to vanish before its active stopping count. -/
theorem remainingTail_ne_zero (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (l : ℕ) (hl : l+1<referenceAtomCount base hb g) :
    remainingTail base g l≠0 := by
  -- The genuine positive metric root cancels its true inverse on the actual current gradient.
  intro hz
  have he : cgCanonicalError base g (l+1)=0 := neg_eq_zero.mp hz
  have hr := congrArg (Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (krylov.Secant.metricRoot base)) he
  have hg : CG.gradient (cgOperator base) g (l+1)=0 := by
    simpa only [cgCanonicalError, ← mul_apply_eq_comp, ← map_mul,
      mul_nonsing_inv _ (krylov.Secant.metricRoot_det_unit base hb), map_one, one_apply_eq_self, map_zero] using hr
  exact cg_nonstagnation base hb g (l+1) hl hg

/-- The actual first canonical step is a unit common direction for all nonempty reference flags.
Use: every individual spectral response bound can be attained along the same actual physical direction.
Article: main_krylov, thm:A, attaining q₀.
Proof: the true CG frame is orthonormal and the first actual step generates every old flag. -/
theorem firstStep_common (base : Matrix (Fin n) (Fin n) ℝ) (hb : base.PosDef)
    (g : EuclideanSpace ℝ (Fin n)) (hcount : 0<referenceAtomCount base hb g) :
    ‖canonicalCGUnitStep base g 0‖=1 ∧ ∀ l, canonicalCGUnitStep base g 0∈oldFlag base g l :=
  ⟨(canonicalCG_frame base hb g).norm_eq_one ⟨0,hcount⟩, fun _ => unitStep_mem_oldFlag base g (Nat.zero_le _)⟩

end
end krylov.Variation
