import krylov.Secant.Metric
import krylov.Secant.Residual

/-!
Article: Definition 2.1 [def:model] of krylov.tex.
Use: distinguish actual queried segments from unevaluated output segments;
all segment operators are explicit and the canonical base metric is shared.
Source: the article's exact operator-sequence definition, without perturbative assumptions.
-/

namespace krylov.Secant
noncomputable section
open Matrix Finset
open scoped Matrix BigOperators

/-- An operator-sequence observation trajectory in the actual physical coordinates.
Use: mathematical model for iterative, probe and correction query histories.
Article: main_krylov, def:model(a). -/
structure OperatorTrajectory (n : ℕ) where
  /-- Query or iterate points, with each consecutive pair defining one segment. -/
  point : ℕ → Fin n → ℝ
  /-- Gradients observed at these points. -/
  gradient : ℕ → Fin n → ℝ
  /-- The physical curvature operator of each consecutive segment. -/
  operator : ℕ → Matrix (Fin n) (Fin n) ℝ
  /-- The operator model requires symmetric segment operators. -/
  symmetric : ∀ k, (operator k).IsSymm
  /-- Each actual gradient increment is the segment operator applied to its step. -/
  update : ∀ k, gradient (k + 1) = gradient k + operator k *ᵥ (point (k + 1) - point k)

/-- The exact radial error model, with symmetric operators at every queried point.
Use: drift budgets are attached to radial observations before conversion to secants.
Article: main_krylov, def:model(b). -/
structure ErrorTrajectory (n : ℕ) where
  /-- Actual query points, including probes and corrections when evaluated. -/
  point : ℕ → Fin n → ℝ
  /-- The common stationary point from which radial displacements are measured. -/
  minimizer : Fin n → ℝ
  /-- Each radial segment has its own actual curvature operator. -/
  operator : ℕ → Matrix (Fin n) (Fin n) ℝ
  /-- Radial operators are symmetric in the error model. -/
  symmetric : ∀ k, (operator k).IsSymm

/-- The observed gradient generated by the radial error model.
Use: gradients are constructed from the model, not supplied with an assumed expansion.
Article: main_krylov, def:model(b). -/
def ErrorTrajectory.gradient {n : ℕ} (T : ErrorTrajectory n) (k : ℕ) : Fin n → ℝ :=
  T.operator k *ᵥ (T.point k - T.minimizer)

/-- Physical drift from a fixed reference radial operator.
Use: distinguish E_s=H_s−H from differences of successive secant operators.
Article: main_krylov, def:model(b). -/
def ErrorTrajectory.drift {n : ℕ} (T : ErrorTrajectory n)
    (H : Matrix (Fin n) (Fin n) ℝ) (k : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  T.operator k - H

/-- The actual displacement of a queried segment.
Use: the step and secant columns are extracted from the same trajectory.
Article: main_krylov, def:model(a), s_k = x_(k+1) − x_k. -/
def OperatorTrajectory.step {n : ℕ} (T : OperatorTrajectory n) (k : ℕ) : Fin n → ℝ :=
  T.point (k + 1) - T.point k

/-- The observed secant of the actual queried segment.
Use: form the window data without assuming an independent list of observations.
Article: main_krylov, def:model(a), y_k = g_(k+1) − g_k. -/
def OperatorTrajectory.secant {n : ℕ} (T : OperatorTrajectory n) (k : ℕ) : Fin n → ℝ :=
  T.gradient (k + 1) - T.gradient k

/-- Every extracted secant is the true segment-operator action.
Use: connects the trajectory to pairImages and the physical flag identities.
Article: main_krylov, def:model(a).
Proof: subtract the old gradient from the defining exact update. -/
theorem OperatorTrajectory.secant_eq {n : ℕ} (T : OperatorTrajectory n) (k : ℕ) :
    T.secant k = T.operator k *ᵥ T.step k := by
  simp only [secant, step, T.update k, add_sub_cancel_left]

/-- The error-model gradient at a query point with an explicit unknown minimizer.
Use: keep query drifts distinct from secant increments before budget conversion.
Article: main_krylov, def:model(b), g_s = H_s(x_s−x_*). -/
def errorGradient {n : ℕ} (H : ℕ → Matrix (Fin n) (Fin n) ℝ)
    (x : ℕ → Fin n → ℝ) (xstar : Fin n → ℝ) (s : ℕ) : Fin n → ℝ :=
  H s *ᵥ (x s - xstar)

/-- A canonical increment of the actual segment operators in a fixed base metric.
Use: defines the independent per-increment budgets used throughout the article.
Article: main_krylov, def:model(c), Ê_l. -/
def canonicalIncrement {n : ℕ} (base : Matrix (Fin n) (Fin n) ℝ)
    (A : ℕ → Matrix (Fin n) (Fin n) ℝ) (l : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
  relativeOperator base (A (l + 1) - A l)

/-- The canonical drift on an independently chosen, unevaluated output segment.
Use: the final output operator is not inferred from the last observed secant.
Article: main_krylov, def:model(c), Ê′. -/
def canonicalOutputIncrement {n : ℕ} (base last output : Matrix (Fin n) (Fin n) ℝ) :
    Matrix (Fin n) (Fin n) ℝ := relativeOperator base (output - last)

/-- The true per-increment spectral budget in the chosen canonical metric.
Use: the scalar bounds are extracted from the actual trajectory operators.
Article: main_krylov, def:model(c), ω_l. -/
def incrementBudget {n : ℕ} (base : Matrix (Fin n) (Fin n) ℝ)
    (A : ℕ → Matrix (Fin n) (Fin n) ℝ) (l : ℕ) : ℝ :=
  chebyshev1.opNorm (canonicalIncrement base A l)

/-- The accumulated observed increments before the last probe of an n-cycle.
Use: the W₀ budget includes the oldest increment and excludes the final output segment.
Article: main_krylov, def:model(c), W₀. -/
def observedBudget (n : ℕ) (ω : ℕ → ℝ) : ℝ := ∑ l ∈ range (n - 1), ω l

/-- The observed budget after removing the oldest increment.
Use: separates W₁ from W₀ in the terminal information estimates.
Article: main_krylov, def:model(c), W₁. -/
def interiorBudget (n : ℕ) (ω : ℕ → ℝ) : ℝ := ∑ l ∈ Ico 1 (n - 1), ω l

/-- The largest increment or output budget, with the empty-cycle convention zero.
Use: fixes the single perturbation scale without assuming a nonempty index set.
Article: main_krylov, def:model(c), ω=max(max_l ω_l,ω′). -/
def maximumBudget (n : ℕ) (ω : ℕ → ℝ) (ωout : ℝ) : ℝ :=
  max ((insert (0 : ℝ) ((range (n - 1)).image ω)).max' (by simp)) ωout

/-- The exact physical increment recursion follows from the actual canonical definition.
Use: discharges the coordinate-reconstruction equation for arbitrary symmetric sequences.
Article: main_krylov, def:model(c), s2:eq:firstorder.
Proof: reconstruct the physical difference by the actual positive metric root. -/
theorem canonicalIncrement_reconstruct {n : ℕ} (base : Matrix (Fin n) (Fin n) ℝ)
    (hbase : base.PosDef) (A : ℕ → Matrix (Fin n) (Fin n) ℝ) (l : ℕ) :
    A (l + 1) = A l + metricRoot base * canonicalIncrement base A l * metricRoot base := by
  rw [canonicalIncrement, relativeOperator_reconstruct base _ hbase]
  abel

end
end krylov.Secant
