import nesterov.Rates.Envelope
import nesterov.Stationary.Polynomial
import polyak.Growth.Quadratic

/-!
Article: Lemma `lem:envelope`, original quadratic lower modes.
Use: every scalar characteristic root is an actual planar Hilbert trajectory,
and at least one positive root modulus bounds Γ from below at every horizon.
-/
namespace nesterov.Rates
noncomputable section
open scoped BigOperators
open StationaryMethod
variable (M : StationaryMethod)

/-- The normalized scalar curvature of a genuine original quadratic. -/
def normalizedCurvature (μ L lam : ℝ) : ℝ := (L+μ-2*lam)/(L-μ)

theorem abs_normalizedCurvature_le_one {μ L lam : ℝ} (hμL : μ<L)
    (hlam : lam∈Set.Icc μ L) : |normalizedCurvature μ L lam|≤1 := by
  rw [abs_le]
  constructor
  · exact (le_div_iff₀ (sub_pos.mpr hμL)).mpr (by nlinarith [hlam.2])
  · exact (div_le_iff₀ (sub_pos.mpr hμL)).mpr (by nlinarith [hlam.1])

/-- The original objective generated by the exact normalization equivalence. -/
def scalarQuadratic (μ L lam : ℝ) (z : ℂ) : ℝ :=
  polyak.denormalizeFunction μ L
    (fun z : ℂ => normalizedCurvature μ L lam / 2 * ‖z‖^2) z

theorem scalarQuadratic_centered {μ L lam : ℝ} (hμ : 0<μ) (hμL : μ<L)
    (hlam : lam∈Set.Icc μ L) :
    polyak.CenteredSmoothStronglyConvex μ L (scalarQuadratic μ L lam) :=
  (polyak.Growth.normalized_quadratic (abs_normalizedCurvature_le_one hμL hlam)).denormalize hμ hμL

theorem gradient_scalarQuadratic {μ L lam : ℝ} (hμL : μ<L) (z : ℂ) :
    gradient (scalarQuadratic μ L lam) z = lam • z := by
  have hg (z : ℂ) : HasGradientAt
      (fun z : ℂ => normalizedCurvature μ L lam / 2 * ‖z‖^2)
      (normalizedCurvature μ L lam • z) z := by
    simpa using polyak.hasGradientAt_quadratic_add (hasGradientAt_const z (0:ℝ))
      (normalizedCurvature μ L lam) 0
  change gradient (polyak.denormalizeFunction μ L
    (fun z : ℂ => normalizedCurvature μ L lam / 2 * ‖z‖^2)) z = _
  rw [(polyak.hasGradientAt_denormalize
    (fun z => (hg z).differentiableAt) z).gradient,(hg z).gradient,smul_smul,← sub_smul]
  have hc : (L+μ)/2-(L-μ)/2*normalizedCurvature μ L lam=lam := by
    dsimp [normalizedCurvature]
    field_simp [ne_of_gt (sub_pos.mpr hμL)]
    ring
  rw [hc]

theorem characteristic_wave {lam : ℝ} {z : ℂ} (hz : M.characteristic lam z=0) :
    M.IsTrajectory (fun x : ℂ => lam • x) (fun k => z^k) := by
  have hp := sub_eq_zero.mp hz
  intro k
  change (∑ j : Fin (M.memory+1), M.recurrenceCoeff j • z^(k+j)) =
    lam • (∑ j : Fin M.memory, M.queryCoeff j • z^(k+j))
  simp only [Complex.real_smul,pow_add]
  calc
    _ = z^k * (∑ j : Fin (M.memory+1), (M.recurrenceCoeff j:ℂ)*z^j.val) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = z^k * ((lam:ℂ)*(∑ j : Fin M.memory, (M.queryCoeff j:ℂ)*z^j.val)) := by
      exact congrArg (fun x : ℂ => z^k*x) hp
    _ = _ := by
      simp only [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring

/-- Every quadratic eigenwave has an exact multiplicative state norm. -/
theorem wave_stateNorm (z : ℂ) (n : ℕ) :
    M.stateNorm (fun k => z^k) n = ‖z‖^n * M.stateNorm (fun k => z^k) 0 := by
  apply (sq_eq_sq₀ (M.stateNorm_nonneg _ _) (mul_nonneg (pow_nonneg (norm_nonneg _) _)
    (M.stateNorm_nonneg _ _))).mp
  rw [M.stateNorm_sq,mul_pow,M.stateNorm_sq]
  simp only [norm_pow,Nat.zero_add,pow_add,norm_mul,mul_pow]
  rw [Finset.mul_sum]

theorem wave_initial_stateNorm_pos (z : ℂ) : 0<M.stateNorm (fun k => z^k) 0 := by
  have hh := M.norm_le_stateNorm (fun k => z^k) 0 ⟨0,M.memory_pos⟩
  simpa using lt_of_lt_of_le (by norm_num : (0:ℝ)<1) (by simpa using hh)

def HilbertRun.ofRoot {μ L lam : ℝ} (hμ : 0<μ) (hμL : μ<L)
    (hlam : lam∈Set.Icc μ L) (z : ℂ) (hz : M.characteristic lam z=0) :
    HilbertRun M μ L where
  Carrier := ℂ
  f := scalarQuadratic μ L lam
  admissible := scalarQuadratic_centered hμ hμL hlam
  w k := z^k
  trajectory := by
    have hh := characteristic_wave M hz
    convert hh using 1
    funext x
    exact gradient_scalarQuadratic hμL x

/-- Every root, including complex and zero roots, gives its exact lower power. -/
theorem characteristicRoot_pow_le_envelope {μ L lam : ℝ} (hμ : 0<μ) (hμL : μ<L)
    (hlam : lam∈Set.Icc μ L) (z : ℂ) (hz : M.characteristic lam z=0) (n : ℕ) :
    ‖z‖^n ≤ envelope M μ L n := by
  have hh := stateNorm_le_envelope (HilbertRun.ofRoot M hμ hμL hlam z hz) n
  change M.stateNorm (fun k => z^k) n ≤ envelope M μ L n * M.stateNorm (fun k => z^k) 0 at hh
  rw [wave_stateNorm] at hh
  exact (mul_le_mul_iff_left₀ (wave_initial_stateNorm_pos M z)).mp hh

/-- A positive uniform exponential lower base, without stability assumptions. -/
theorem envelope_lower_base {μ L : ℝ} (hμ : 0<μ) (hμL : μ<L) :
    ∃ b : ℝ,0<b ∧ ∀ n : ℕ,b^n≤envelope M μ L n := by
  obtain ⟨lam,hlam,z,hz0,hz⟩ := M.exists_nonzero_characteristic_root hμL
  exact ⟨‖z‖,norm_pos_iff.mpr hz0,characteristicRoot_pow_le_envelope M hμ hμL hlam z hz⟩

theorem envelope_pos {μ L : ℝ} (hμ : 0<μ) (hμL : μ<L) (n : ℕ) :
    0<envelope M μ L n := by
  obtain ⟨b,hb,hbound⟩ := envelope_lower_base M hμ hμL
  exact (pow_pos hb n).trans_le (hbound n)

theorem envelope_zero {μ L : ℝ} (hμ : 0<μ) (hμL : μ<L) : envelope M μ L 0=1 := by
  apply le_antisymm
  · simpa using envelope_le M μ L 0
  · obtain ⟨b,_hb,hbound⟩ := envelope_lower_base M hμ hμL
    simpa using hbound 0

end
end nesterov.Rates
