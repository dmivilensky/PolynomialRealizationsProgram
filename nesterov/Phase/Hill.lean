import nesterov.Phase.SingleAtom
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.LinearAlgebra.Matrix.Notation

/-!
Article: Remark `hill`.
Use: a feasible planar mode is generated by periodic symmetric contractions.
The real-linear complex operators are identified with the article's explicit
2×2 matrices; the same construction exhibits the stationary rotating frame.
-/

namespace nesterov.Phase
noncomputable section
open scoped InnerProductSpace BigOperators

/-- The trace-free symmetric matrix [[Re p,Im p],[Im p,-Re p]], as a genuine
real-linear operator on the complex plane. -/
def curvatureLinear (p : ℂ) : ℂ →ₗ[ℝ] ℂ where
  toFun z := p * star z
  map_add' z w := by simp [mul_add]
  map_smul' a z := by simp [Complex.real_smul, mul_comm, mul_left_comm]

def curvature (p : ℂ) : ℂ →L[ℝ] ℂ :=
  (curvatureLinear p).mkContinuous ‖p‖ (fun z => by simp [curvatureLinear])

@[simp] theorem curvature_apply (p z : ℂ) : curvature p z = p * star z := rfl

theorem curvature_norm_apply (p z : ℂ) : ‖curvature p z‖ = ‖p‖ * ‖z‖ := by simp

theorem curvature_norm (p : ℂ) : ‖curvature p‖ = ‖p‖ := by
  apply le_antisymm
  · exact (curvature p).opNorm_le_bound (norm_nonneg p) (fun z => (curvature_norm_apply p z).le)
  · have hh := (curvature p).le_opNorm (1 : ℂ)
    simpa using hh

theorem curvature_symmetric (p : ℂ) : (curvature p : ℂ →ₗ[ℝ] ℂ).IsSymmetric := by
  intro z w
  simp [curvature_apply, Complex.inner, Complex.mul_re, Complex.mul_im]
  ring

theorem curvature_selfAdjoint (p : ℂ) : IsSelfAdjoint (curvature p) :=
  (curvature_symmetric p).isSelfAdjoint

def curvatureMatrix (p : ℂ) : Matrix (Fin 2) (Fin 2) ℝ := !![p.re, p.im; p.im, -p.re]

theorem curvature_matrix_dictionary (p z : ℂ) :
    (curvature p z).re = curvatureMatrix p 0 0 * z.re + curvatureMatrix p 0 1 * z.im ∧
      (curvature p z).im = curvatureMatrix p 1 0 * z.re + curvatureMatrix p 1 1 * z.im := by
  simp [curvatureMatrix, Complex.mul_re, Complex.mul_im]
  ring

theorem curvatureMatrix_isHermitian (p : ℂ) : (curvatureMatrix p).IsHermitian := by
  apply Matrix.IsHermitian.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [curvatureMatrix]

theorem curvatureMatrix_trace (p : ℂ) : Matrix.trace (curvatureMatrix p) = 0 := by
  simp [Matrix.trace, curvatureMatrix, Fin.sum_univ_two]

theorem curvature_first_column (p : ℂ) : curvature p 1 = p := by simp

/-- At time n the trace-free part has rotated by twice the phase nω. -/
def rotatingCurvature (p ζ : ℂ) (n : ℕ) : ℂ →L[ℝ] ℂ := curvature (ζ ^ (2 * n) * p)

theorem rotatingCurvature_symmetric (p ζ : ℂ) (n : ℕ) :
    (rotatingCurvature p ζ n : ℂ →ₗ[ℝ] ℂ).IsSymmetric := curvature_symmetric _

theorem rotatingCurvature_norm (p : ℂ) {ζ : ℂ} (hζ : ‖ζ‖ = 1) (n : ℕ) :
    ‖rotatingCurvature p ζ n‖ = ‖p‖ := by
  simp [rotatingCurvature, curvature_norm, norm_pow, hζ]

/-- Exact conjugation H_n=R^n H_0 R^{-n}, with R multiplication by ζ. -/
theorem rotatingCurvature_conjugation (p : ℂ) {ζ : ℂ} (hζ : ‖ζ‖ = 1) (n : ℕ) (z : ℂ) :
    rotatingCurvature p ζ n z = ζ ^ n * curvature p ((ζ ^ n)⁻¹ * z) := by
  have hz : ‖ζ ^ n‖ = 1 := by simp [norm_pow, hζ]
  rw [Complex.inv_eq_conj hz]
  simp only [rotatingCurvature, curvature_apply, star_mul,
    Complex.star_def, Complex.conj_conj]
  rw [show 2 * n = n + n by omega, pow_add]
  ring

theorem rotatingCurvature_periodic (p ζ : ℂ) {K : ℕ} (hK : ζ ^ K = 1) :
    Function.Periodic (rotatingCurvature p ζ) K := by
  intro n
  dsimp [rotatingCurvature]
  congr 1
  have h2K : ζ ^ (2 * K) = 1 := by rw [Nat.mul_comm 2 K, pow_mul, hK, one_pow]
  rw [Nat.mul_add, pow_add, h2K, mul_one]

theorem rotatingCurvature_mode (p : ℂ) {ζ : ℂ} (hζ : ‖ζ‖ = 1) (A : ℝ) (n : ℕ) :
    rotatingCurvature p ζ n ((A : ℂ) * ζ ^ n) = p * ((A : ℂ) * ζ ^ n) := by
  have hz : ζ ^ n ≠ 0 := by apply norm_ne_zero_iff.mp; simp [norm_pow, hζ]
  rw [rotatingCurvature_conjugation p hζ]
  have he : (ζ ^ n)⁻¹ * ((A : ℂ) * ζ ^ n) = (A : ℂ) := by field_simp
  rw [he, curvature_apply]
  simp only [Complex.star_def, Complex.conj_ofReal]
  ring

def queryPhase (u : ℂ) : ℂ := (‖u‖ : ℂ) / u

theorem queryPhase_norm {u : ℂ} (hu : u ≠ 0) : ‖queryPhase u‖ = 1 := by
  rw [queryPhase, norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg u)]
  exact div_self (norm_ne_zero_iff.mpr hu)

theorem queryPhase_query {u : ℂ} (hu : u ≠ 0) : queryPhase u * u = (‖u‖ : ℂ) := by
  dsimp [queryPhase]
  field_simp

theorem queryPhase_gradient (u p : ℂ) : queryPhase u * p = (p / u) * (‖u‖ : ℂ) := by
  dsimp [queryPhase]
  ring

theorem normalizedRatio_norm_le_one {u p : ℂ} (hu : u ≠ 0)
    (hg : 0 ≤ Complex.normSq u - Complex.normSq p) : ‖p / u‖ ≤ 1 := by
  rw [norm_div, div_le_one (norm_pos_iff.mpr hu)]
  rw [Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq] at hg
  nlinarith [norm_nonneg p, norm_nonneg u]

/-- Feasibility supplies precisely the contraction norm needed by the Hill
interpretation, in query normalization. -/
theorem ratio_norm_le_one_of_singleton {a : Spectral.SymbolPair} {t C : ℝ}
    {c : Spectral.Frequency} (hu : a.u c ≠ 0)
    (hf : Spectral.Feasible a t (singletonSpectrum c) C) : ‖a.p c / a.u c‖ ≤ 1 := by
  apply normalizedRatio_norm_le_one hu
  have hh := hf.meanG_nonneg
  simpa only [singleton_meanG, Spectral.g] using hh

/-- The actual planar gradient relation in the basis where the initial query
is real and positive. -/
theorem hill_gradient_relation {u : ℂ} (hu : u ≠ 0) (p : ℂ) {ζ : ℂ} (hζ : ‖ζ‖ = 1) (n : ℕ) :
    queryPhase u * (p * ζ ^ n) = rotatingCurvature (p / u) ζ n (queryPhase u * (u * ζ ^ n)) := by
  have he : queryPhase u * (u * ζ ^ n) = (‖u‖ : ℂ) * ζ ^ n := by
    rw [← mul_assoc, queryPhase_query hu]
  rw [he, rotatingCurvature_mode _ hζ]
  rw [← mul_assoc, queryPhase_gradient]
  ring

/-- A scalar curvature can realize this orbit exactly when the normalized
gradient has no imaginary component.  The trace-free example above need
not itself be the scalar choice. -/
theorem scalar_curvature_iff (p : ℂ) (A : ℝ) (hA : A ≠ 0) (ζ : ℂ) :
    (∃ a : ℝ, ∀ n : ℕ, p * ((A : ℂ) * ζ ^ n) = a • ((A : ℂ) * ζ ^ n)) ↔ p.im = 0 := by
  constructor
  · rintro ⟨a, ha⟩
    have hh := ha 0
    simp only [pow_zero, mul_one, Complex.real_smul] at hh
    have hp : p = (a : ℂ) := mul_right_cancel₀ (by exact_mod_cast hA) hh
    rw [hp]
    simp
  · intro hp
    refine ⟨p.re, fun n => ?_⟩
    have he : p = (p.re : ℂ) := by apply Complex.ext <;> simp [hp]
    rw [he, Complex.real_smul]
    simp

/-- In the rotating frame the orbit is a fixed point, with unit Floquet
multiplier.  This is an identity of the complete orbit, not only its norm. -/
theorem rotating_frame_fixed (A ζ : ℂ) (hζ : ζ ≠ 0) (n : ℕ) :
    (ζ ^ n)⁻¹ * (A * ζ ^ n) = A := by field_simp

theorem rational_phase_period {K : ℕ} (hK : 0 < K) (j : ℕ) :
    polyak.Waves.z 0 (2 * Real.pi * j / K) ^ K = 1 := by
  have hKr : (K : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hK)
  have he : (K : ℝ) * (2 * Real.pi * j / K) = 2 * Real.pi * j := by field_simp
  apply Complex.ext
  · rw [polyak.Waves.z_pow_re]
    simp only [mul_zero, Real.exp_zero, one_mul, Complex.one_re]
    rw [he]
    rw [show 2 * Real.pi * (j : ℝ) = (j : ℝ) * (2 * Real.pi) by ring]
    exact Real.cos_nat_mul_two_pi j
  · rw [polyak.Waves.z_pow_im]
    simp only [mul_zero, Real.exp_zero, one_mul, Complex.one_im]
    rw [he]
    rw [show 2 * Real.pi * (j : ℝ) = ((2 * j : ℕ) : ℝ) * Real.pi by push_cast; ring]
    exact Real.sin_nat_mul_pi (2 * j)

theorem finite_filter_wave {I : Type*} [Fintype I] (index : I → ℕ)
    (coeff : I → ℝ) (A ζ : ℂ) (n : ℕ) :
    (∑ j, coeff j • (A * ζ ^ (n + index j))) =
      (∑ j, (coeff j : ℂ) * ζ ^ index j) * A * ζ ^ n := by
  simp only [Complex.real_smul, pow_add, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The normalized stationary recursion on the complete planar orbit is
exactly a linear recursion with the rotating symmetric coefficients H_n. -/
theorem hill_recursion {D : ℕ} (ucoeff : Fin D → ℝ) (pcoeff : Fin (D + 1) → ℝ)
    {ζ : ℂ} (hζ : ‖ζ‖ = 1)
    (hu : (∑ j : Fin D, (ucoeff j : ℂ) * ζ ^ j.val) ≠ 0) (n : ℕ) :
    let U := ∑ j : Fin D, (ucoeff j : ℂ) * ζ ^ j.val
    let P := ∑ j : Fin (D + 1), (pcoeff j : ℂ) * ζ ^ j.val
    (∑ j : Fin (D + 1), pcoeff j • (queryPhase U * ζ ^ (n + j.val))) =
      rotatingCurvature (P / U) ζ n
        (∑ j : Fin D, ucoeff j • (queryPhase U * ζ ^ (n + j.val))) := by
  dsimp only
  rw [finite_filter_wave, finite_filter_wave]
  have hh := hill_gradient_relation hu (∑ j : Fin (D + 1), (pcoeff j : ℂ) * ζ ^ j.val) hζ n
  convert hh using 1
  · ring
  · congr 1
    ring

/-- All statements in the Hill interpretation for a feasible planar mode:
the actual gradient relation, symmetric contractions, and periodicity at a
rational phase. The fixed-frame identity is `rotating_frame_fixed`. -/
theorem feasible_hill_representation {a : Spectral.SymbolPair} {t C : ℝ}
    {c : Spectral.Frequency} (hu : a.u c ≠ 0)
    (hf : Spectral.Feasible a t (singletonSpectrum c) C) :
    let ζ := polyak.Waves.z 0 (Real.arccos c)
    let p := a.p c / a.u c
    (∀ n : ℕ, (rotatingCurvature p ζ n : ℂ →ₗ[ℝ] ℂ).IsSymmetric ∧
      ‖rotatingCurvature p ζ n‖ ≤ 1 ∧
      queryPhase (a.u c) * (a.p c * ζ ^ n) =
        rotatingCurvature p ζ n (queryPhase (a.u c) * (a.u c * ζ ^ n))) ∧
    (∀ K : ℕ, ζ ^ K = 1 → Function.Periodic (rotatingCurvature p ζ) K) := by
  dsimp only
  have hζ : ‖polyak.Waves.z 0 (Real.arccos c)‖ = 1 := by
    simpa using polyak.Waves.norm_z_pow 0 (Real.arccos c) 1
  refine ⟨fun n => ⟨rotatingCurvature_symmetric _ _ _, ?_, hill_gradient_relation hu _ hζ n⟩,
    fun K hK => rotatingCurvature_periodic _ _ hK⟩
  rw [rotatingCurvature_norm _ hζ]
  exact ratio_norm_le_one_of_singleton hu hf

/-- The operator representation is attached to the actual u,p polynomials of
the repository's stationary-method executor. -/
theorem stationary_hill_recursion (M : StationaryMethod) (μ L : ℝ)
    {ζ : ℂ} (hζ : ‖ζ‖ = 1)
    (hu : (M.queryPolynomial.map Complex.ofRealHom).eval ζ ≠ 0) (n : ℕ) :
    let U := (M.queryPolynomial.map Complex.ofRealHom).eval ζ
    let P := ((M.normalizedPolynomial μ L).map Complex.ofRealHom).eval ζ
    (∑ j : Fin (M.memory + 1), M.normalizedCoeff μ L j •
      (queryPhase U * ζ ^ (n + j.val))) =
      rotatingCurvature (P / U) ζ n (M.query (fun k => queryPhase U * ζ ^ k) n) := by
  have hU : (M.queryPolynomial.map Complex.ofRealHom).eval ζ =
      ∑ j : Fin M.memory, (M.queryCoeff j : ℂ) * ζ ^ j.val := by
    simp only [StationaryMethod.queryPolynomial, Polynomial.map_sum, Polynomial.map_monomial,
      Polynomial.eval_finsetSum, Polynomial.eval_monomial, Complex.ofRealHom_eq_coe]
  have hP : ((M.normalizedPolynomial μ L).map Complex.ofRealHom).eval ζ =
      ∑ j : Fin (M.memory + 1), (M.normalizedCoeff μ L j : ℂ) * ζ ^ j.val := by
    rw [M.normalizedPolynomial_eq_sum]
    simp only [Polynomial.map_sum, Polynomial.map_monomial,
      Polynomial.eval_finsetSum, Polynomial.eval_monomial, Complex.ofRealHom_eq_coe]
  have hu' : (∑ j : Fin M.memory, (M.queryCoeff j : ℂ) * ζ ^ j.val) ≠ 0 := by rwa [← hU]
  have hh := hill_recursion M.queryCoeff (M.normalizedCoeff μ L) hζ hu' n
  dsimp only at hh ⊢
  rw [← hU, ← hP] at hh
  exact hh

/-- Matrix entries make the doubled phase rotation of the trace-free part
explicit, rather than identifying it only up to conjugation. -/
theorem rotating_matrix_phase (p : ℂ) (ω : ℝ) (n : ℕ) :
    (curvatureMatrix ((polyak.Waves.z 0 ω) ^ (2 * n) * p)) 0 0 =
      Real.cos ((2 * n : ℕ) * ω) * p.re - Real.sin ((2 * n : ℕ) * ω) * p.im ∧
    (curvatureMatrix ((polyak.Waves.z 0 ω) ^ (2 * n) * p)) 0 1 =
      Real.sin ((2 * n : ℕ) * ω) * p.re + Real.cos ((2 * n : ℕ) * ω) * p.im := by
  simp [curvatureMatrix, Complex.mul_re, Complex.mul_im,
    polyak.Waves.z_pow_re, polyak.Waves.z_pow_im]
  ring

theorem scalar_contraction_iff {p : ℂ} (hp : ‖p‖ ≤ 1) :
    (∃ a : ℝ, |a| ≤ 1 ∧ (a : ℂ) = p) ↔ p.im = 0 := by
  constructor
  · rintro ⟨a, _, rfl⟩
    simp
  · intro him
    have he : (p.re : ℂ) = p := by apply Complex.ext <;> simp [him]
    refine ⟨p.re, ?_, he⟩
    have hn : |p.re| = ‖p‖ := by rw [← he, Complex.norm_real, Real.norm_eq_abs]; simp
    rwa [hn]

/-- The scalar-curvature case is exactly a genuine quadratic mode with
curvature in [μ,L], for the method's original characteristic polynomial. -/
theorem query_ratio_quadratic_iff (M : StationaryMethod) {μ L : ℝ} (hμL : μ < L)
    (ζ : ℂ) (hu : (M.queryPolynomial.map Complex.ofRealHom).eval ζ ≠ 0)
    (hnorm : ‖((M.normalizedPolynomial μ L).map Complex.ofRealHom).eval ζ /
      (M.queryPolynomial.map Complex.ofRealHom).eval ζ‖ ≤ 1) :
    (((M.normalizedPolynomial μ L).map Complex.ofRealHom).eval ζ /
      (M.queryPolynomial.map Complex.ofRealHom).eval ζ).im = 0 ↔
      ∃ lam ∈ Set.Icc μ L, M.characteristic lam ζ = 0 := by
  let U := (M.queryPolynomial.map Complex.ofRealHom).eval ζ
  let V := (M.recurrencePolynomial.map Complex.ofRealHom).eval ζ
  let P := ((M.normalizedPolynomial μ L).map Complex.ofRealHom).eval ζ
  let r := P / U
  have hU : U ≠ 0 := hu
  have hd : (L : ℂ) - (μ : ℂ) ≠ 0 := by exact_mod_cast sub_ne_zero.mpr hμL.ne'
  have hp : P = ((L + μ) / (L - μ) : ℝ) * U - (2 / (L - μ) : ℝ) * V :=
    M.normalizedPolynomial_complex_eval μ L ζ
  have hc (lam : ℝ) : M.characteristic lam ζ = V - (lam : ℂ) * U := by
    rw [M.characteristic_eq_polynomial_eval]
    simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C]
    rfl
  constructor
  · intro him
    change r.im = 0 at him
    have hre : |r.re| ≤ 1 := (Complex.abs_re_le_norm r).trans hnorm
    let lam := (L + μ) / 2 - (L - μ) / 2 * r.re
    have hwidth : 0 < L - μ := sub_pos.mpr hμL
    have hlam : lam ∈ Set.Icc μ L := by
      dsimp [lam]
      have hupper := mul_nonneg hwidth.le (show 0 ≤ 1 - r.re by linarith [(abs_le.mp hre).2])
      have hlower := mul_nonneg hwidth.le (show 0 ≤ r.re + 1 by linarith [(abs_le.mp hre).1])
      constructor <;> nlinarith
    refine ⟨lam, hlam, ?_⟩
    rw [hc]
    have hr : P / U = (r.re : ℂ) := by
      apply Complex.ext
      · rfl
      · exact him
    have hPr : P = (r.re : ℂ) * U := (div_eq_iff hU).mp hr
    rw [hPr] at hp
    dsimp [lam]
    push_cast at hp ⊢
    field_simp [hd] at hp ⊢
    linear_combination hp
  · rintro ⟨lam, _, hchar⟩
    rw [hc] at hchar
    have hV : V = (lam : ℂ) * U := sub_eq_zero.mp hchar
    have hr : P / U = (((L + μ - 2 * lam) / (L - μ) : ℝ) : ℂ) := by
      apply (div_eq_iff hU).mpr
      rw [hp, hV]
      push_cast
      field_simp [hd]
    change (P / U).im = 0
    exact (congrArg Complex.im hr).trans (Complex.ofReal_im _)

end
end nesterov.Phase
